datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//// ===================== ENUMS =====================

enum UserRole {
  USER
  ADMIN
}

enum CourseType {
  GRAMMAR
  VOCABULARY
  LISTENING
}

enum LessonTaskType {
  VIDEO
  QUIZ
  // Sprint 06D — Advanced Practice: separately authored, harder, more
  // contextual questions that extend the lesson once the student can already
  // answer it directly.
  //
  // It is NOT a second quiz and NOT derived from the student's mistakes —
  // that is Trap Hunter, which stays derived from the QUIZ task alone. The
  // difference is the source of the content: Trap Hunter replays questions
  // the student got wrong, Advanced Practice presents questions an author
  // wrote for this purpose.
  //
  // Its questions are ordinary Question rows and its progress is an ordinary
  // LessonTaskProgress row keyed by THIS task's id. That is what keeps its
  // scoring structurally separate from the quiz's — a different taskId is a
  // different row, so "Practice never writes to the quiz's score" is a
  // property of the schema rather than a rule someone has to remember.
  PRACTICE
  // @deprecated Sprint 06B — these two are QUESTION types (see QuestionType
  // below), not task types; they leaked into this enum before the Lesson
  // Quiz Engine existed. Zero rows and zero code references as of Sprint
  // 06B. Kept rather than dropped — removing a Postgres enum value is
  // disruptive and buys nothing since nothing reads them. A quiz task is
  // always `QUIZ`; a question's own `type` says whether it's multiple
  // choice, true/false, fill-blank or ordering. "Quiz is one kind of
  // LessonTask; LessonTask is not a synonym for Quiz."
  ARRANGE
  TRUE_FALSE
}

// DEAD as of Sprint 07. Written exactly once in the whole backend
// (QuizService.answerTaskQuestion sets IN_PROGRESS) and NEVER set to
// COMPLETED — under ON_SUBMIT feedback the answer path never runs at all, so
// a fully-passed quiz keeps NOT_STARTED forever. `completedAt` is the real
// signal and always has been.
//
// Sprint 07 deliberately did NOT "fix" this by adding writes: nothing reads
// the column, and a stored status beside completedAt is a second
// representation of one fact — which is how it came to disagree in the first
// place. LessonStepProgress therefore has no status column and derives its
// state from timestamps instead. Removal of this column is scheduled with the
// deprecated-endpoint cleanup.
//
// DO NOT read or write this from new code.
enum TaskProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// Sprint 07 — the two lesson steps that are CONSUMED rather than answered.
// Deliberately not LessonTaskType values: a quiz/practice task carries
// questions and hangs off LessonTask, whereas a video and its theory notes
// are columns on Lesson itself (videoUrl, notes). Modelling these as tasks
// would need a contentless LessonTask row per lesson plus a backfill, and
// would create two disagreeing answers to "does this lesson have a video?"
// — lesson.videoUrl and the task row.
enum LessonStepKind {
  VIDEO
  THEORY
}

// Sprint 06B — Lesson Quiz Engine. Deliberately NOT open-ended: only types
// that can actually be graded (grade-question.ts) AND rendered (a per-type
// input component) may exist here, so no row can ever carry a type the
// student UI cannot display. Extensibility lives in code, not the schema —
// see grade-question.ts's GRADERS registry, which makes "add an enum value
// without a grader" a compile error, not a runtime 500 in front of a
// student. Adding a reserved type later is one grader + one input
// component + one `ALTER TYPE ... ADD VALUE` migration.
//
// RESERVED (not implemented — add together with their grader, never
// before): MATCHING, DRAG_DROP, IMAGE_CHOICE, AUDIO_CHOICE, SHORT_ANSWER.
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  ORDERING
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// Sprint 06B.5 — when a quiz tells the student whether they were right.
//
// IMMEDIATE: grade each answer as it is given, reveal the correct answer and
//   the authored explanation straight away, then lock that question. Built
//   for LEARNING — a student who is wrong finds out while the question is
//   still in their head.
// ON_SUBMIT: the Sprint 06B behaviour — answer everything, submit once, see
//   the verdict at the end. Built for ASSESSMENT (a timed mock exam).
//
// This is a property of the QUIZ, never of the course type. Nothing in the
// quiz engine branches on CourseType — a Grammar lesson is IMMEDIATE because
// its author chose that, not because the engine knows what Grammar is.
enum QuizFeedbackMode {
  IMMEDIATE
  ON_SUBMIT
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  PHRASE
  IDIOM
}

enum WordSource {
  ADMIN
  IMPORT
  AI
}

// Sprint 04 — Learning Engine (SRS). See docs/adr/007-learning-engine-srs.md.
enum LearningState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
  MASTERED
  // SUSPENDED deliberately omitted — no code path sets it in Sprint 04;
  // added via its own migration if a future "stop reviewing this word"
  // feature is designed.
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum PracticeSource {
  FLASHCARD
  DICTATION
  REVIEW
  // GAMES deliberately absent — Games never submits SRS reviews (Sprint 04 scope).
}

//// ===================== MODELS =====================
//
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String? // nullable: Google-only accounts (Sprint 02A) have no local password
  name      String
  avatarUrl String? //can be null
  role      UserRole @default(USER)

  totalPoints Int @default(0)
  level       Int @default(1)

  createdAt       DateTime  @default(now())
  // Set only when the backend has cryptographically verified email ownership
  // (currently: a successful Google ID-token verification with
  // email_verified=true, at account-creation or account-linking time).
  // Sprint 02A writes this field; nothing reads or branches on it yet — it
  // exists so a future local-email-verification sprint (02B) inherits
  // accurate data with no backfill guesswork. NULL for every pre-existing
  // local account, which is accurate: their email ownership was never
  // verified.
  emailVerifiedAt DateTime?

  // Sprint 04 (Learning Engine): set at most once from a client-supplied
  // bootstrap value (see LearningService) — never re-derived per request,
  // so a user can't reset their daily new-word quota by spoofing a
  // different timezone on each call. NULL means "not yet learned" and all
  // day-bucketing falls back to UTC.
  timezone String?

  taskProgress            LessonTaskProgress[]
  taskAttempts            LessonTaskAttempt[]
  stepProgress            LessonStepProgress[]
  identities              AuthIdentity[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  wordProgress            UserWordProgress[]
  wordReviewLogs          WordReviewLog[]

  @@map("users") //users dùng cho query sql , còn User dùng cho code
}

enum AuthProvider {
  GOOGLE
}

// One row per external identity provider linked to a User (Sprint 02A). A
// separate table (not googleId/provider columns on User) so one account can
// hold multiple provider identities without nullable-column sprawl as more
// providers are added later.
model AuthIdentity {
  id     String @id @default(uuid())
  userId String

  provider        AuthProvider
  providerSubject String // Google's `sub` claim — stable, opaque, never the email
  providerEmail   String // verified email at link time — audit trail only, never a login key

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

// Single-use, expiring, opaque token proving control of a local account's
// email inbox (Sprint 02B). Only a SHA-256 hash of the token is ever stored
// — see src/auth/tokens/secure-token.util.ts. Issuing a new token for a user
// invalidates every previous outstanding one (AuthService.resendVerification/
// register set every prior unconsumed row's consumedAt before inserting the
// new row, in the same transaction).
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Single-use, expiring, opaque token proving legitimate password-reset intent
// (Sprint 02C). Same generation/hashing/consumption mechanics as
// EmailVerificationToken (see src/auth/tokens/secure-token.util.ts) but a
// separate table — the two token types carry different operational policies
// (reset triggers full session revocation and treats replay as a security
// signal; verification does neither). A successful reset consumes every
// outstanding row for the user (not only the one presented) and, per ADR 006
// Invariant 1, also consumes every outstanding EmailVerificationToken row for
// that user in the same transaction.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Course {
  id          String     @id @default(uuid())
  title       String
  type        CourseType
  description String
  thumbnail   String?
  isPublished Boolean    @default(false)

  createdAt DateTime @default(now())

  lessons Lesson[]

  @@map("courses")
}

model Lesson {
  id          String  @id @default(uuid())
  courseId    String
  title       String
  description String?
  notes       String?

  videoUrl              String?
  pdfUrl                String?
  audioUrl              String?
  videoDurationMinutes  Int?
  estimatedStudyMinutes Int?
  learningObjectives    String[] @default([])

  orderIndex  Int
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course       Course             @relation(fields: [courseId], references: [id])
  tasks        LessonTask[]
  vocabularies LessonVocabulary[]
  stepProgress LessonStepProgress[]

  @@index([courseId])
  @@map("lessons")
}

// Sprint 07 — durable progress for the VIDEO and THEORY steps. Before this,
// both lived ONLY in the browser's localStorage, which made two of the five
// stages that gate lesson completion device-local, client-forgeable and
// invisible to the server: a lesson finished on a laptop read as unfinished
// on a phone, permanently.
model LessonStepProgress {
  id       String         @id @default(uuid())
  userId   String
  lessonId String
  step     LessonStepKind

  // There is NO status enum here, and that is deliberate — see the note on
  // TaskProgressStatus. State is derived from these two timestamps:
  //   completedAt != null -> COMPLETED
  //   startedAt   != null -> IN_PROGRESS
  //   neither             -> NOT_STARTED
  // One fact, one representation, nothing that can disagree with itself.
  startedAt DateTime?
  // Set once and NEVER cleared by any code path. Rewatching a finished video
  // or reopening finished theory updates lastActivityAt only — a review must
  // never cost a student their completion.
  completedAt DateTime?

  // Written explicitly by the service, not via @updatedAt: @updatedAt would
  // fire on every write and mean "last written", which for THEORY (whose only
  // writes are start and complete) is not the same thing as "last accessed".
  lastActivityAt DateTime @default(now())

  // VIDEO only; null for THEORY. Monotonic — the service takes max(stored,
  // reported), so seeking backwards or replaying can never lower it.
  highestPositionSeconds Int?
  // WRITE-ONCE. Captured from the first report that carries a usable duration
  // and never updated afterwards.
  //
  // This is the anti-abuse floor for the 90% completion gate. The gate has no
  // anti-seek rule by product decision (dragging to the end completes the
  // step), but without freezing the denominator a later {positionSeconds: 1,
  // durationSeconds: 1} payload would complete any video whose lesson has no
  // authored videoDurationMinutes — which is most of them, since the column
  // is nullable.
  videoDurationSeconds Int?

  // Cascade on both sides. The user side matches LessonTaskProgress and
  // UserWordProgress (deleting an account takes its own progress with it).
  //
  // The lesson side deliberately DIVERGES from LessonTaskProgress.task, which
  // is Restrict so a quiz with real attempts cannot be deleted. A watch
  // position is not graded work, and Restrict here would make the existing
  // admin DELETE /lessons/:id start throwing P2003 for any lesson a student
  // had merely opened — a behaviour change well outside Sprint 07's scope.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, step])
  // Serves the Sprint 07-D daily dashboard ("lessons completed today") without
  // needing a second index later.
  @@index([userId, completedAt])
  // Sprint 09 — the activity calendar / streak window, which asks "did this
  // user touch anything on day N". completedAt above cannot answer it: a
  // student who watched half a video today completed nothing, but the day is
  // still an active day. lastActivityAt is the only column that moves on every
  // visit, so it is the one the streak reads.
  @@index([userId, lastActivityAt])
  @@map("lesson_step_progress")
}

model LessonTask {
  id         String         @id @default(uuid())
  lessonId   String
  type       LessonTaskType
  title      String
  content    Json
  points     Int
  orderIndex Int

  // Sprint 06B — a quiz with unsaved/incomplete authoring must not reach
  // students. Defaults false: an admin has to explicitly publish, mirroring
  // Lesson.isPublished's own default.
  isPublished Boolean @default(false)
  // Null falls back to the QUIZ_DEFAULT_PASSING_SCORE_PERCENT env default
  // (see QuizService) — never hardcoded per the sprint spec.
  passingScorePercent Int?

  // Sprint 06B.5 — see QuizFeedbackMode. Defaults to IMMEDIATE because the
  // lessons this engine serves today are for learning, not examination; an
  // author picks ON_SUBMIT explicitly when they want a test.
  feedbackMode QuizFeedbackMode @default(IMMEDIATE)

  createdAt DateTime @default(now())

  // Restrict (default, explicit here for clarity): a task with real student
  // attempts (LessonTaskProgress rows) cannot be deleted, only unpublished —
  // same reasoning as UserWordProgress's word relation. This is also what
  // keeps `Lesson.remove()`'s existing "cannot delete a lesson with tasks"
  // guard meaningful.
  lesson    Lesson               @relation(fields: [lessonId], references: [id])
  questions Question[]
  progress  LessonTaskProgress[]
  attempts  LessonTaskAttempt[]

  // Sprint 06D — one task of each kind per lesson. Every lookup in the
  // engine is `findFirst({ where: { lessonId, type, isPublished } })` with no
  // `orderBy`, so before this constraint two rows of the same type on one
  // lesson meant the student silently got whichever Postgres returned first —
  // and could get a different one on the next request. Verified duplicate-free
  // on both databases before adding (0 groups across 4 dev rows / 0 test).
  //
  // This also makes the admin whole-document upsert honest: it must UPDATE the
  // existing task rather than insert a second one, and now fails loudly
  // instead of quietly creating an ambiguity nobody would notice until a
  // student saw the wrong quiz.
  @@unique([lessonId, type])
  @@map("lesson_tasks")
}

model Question {
  id            String              @id @default(uuid())
  taskId        String
  content       String
  // Sprint 06B — required; every question authored from this sprint forward
  // must declare its grading shape. See grade-question.ts for the per-type
  // options/correctAnswer contract this drives.
  type          QuestionType        @default(MULTIPLE_CHOICE)
  difficulty    QuestionDifficulty?
  options       Json?
  correctAnswer Json
  explanation   String?
  audioUrl      String?
  imageUrl      String?
  orderIndex    Int

  task LessonTask @relation(fields: [taskId], references: [id])

  @@map("questions")
}

//Một user có thể có nhiều tiến độ làm bài
model LessonTaskProgress {
  id            String             @id @default(uuid())
  userId        String
  taskId        String
  status        TaskProgressStatus @default(NOT_STARTED)
  score         Int                @default(0)
  maxScore      Int
  attemptsCount Int                @default(0)
  completedAt   DateTime?

  // Sprint 06B — stamped by the quiz GET when no attempt is currently in
  // flight; submit() computes elapsed time as `now - attemptStartedAt`, so
  // the number reflects real time spent and survives a mid-quiz refresh
  // (the GET does not re-stamp an in-flight attempt).
  attemptStartedAt DateTime?
  // Null when the gap since attemptStartedAt exceeds a sane cap (a tab left
  // open overnight) — the summary omits the row rather than showing a
  // fabricated number, the same rule Sprint 06A uses for absent content
  // blocks.
  lastDurationSeconds Int?

  // Idempotency for POST .../quiz/submit, scoped to this (user, task) row —
  // no separate per-attempt log table exists, so a retried submission is
  // recognised by comparing against the MOST RECENT attempt only (same
  // "replay the original recorded outcome" contract as Sprint 04's
  // WordReviewLog, sized down: one prior attempt of memory instead of an
  // append-only history, which this feature does not need). A resubmission
  // with the same lastClientAttemptId but different answers is a conflict
  // (QuizIdempotencyConflictException, never silently re-graded); the same
  // id with the same answers replays lastSubmitResult verbatim rather than
  // re-computing it.
  lastClientAttemptId String?
  lastAnswers         Json?
  lastSubmitResult    Json?

  // Sprint 06B.5 — the IN-FLIGHT attempt's server-graded answers, shaped
  //   { [questionId]: { submitted, isCorrect, answeredAt } }
  // Deliberately distinct from lastAnswers/lastSubmitResult above, which
  // record the most recent COMPLETED attempt for idempotent replay.
  //
  // This is the ONLY input to scoring under IMMEDIATE feedback, and that is
  // a security property, not an implementation detail: once a question's
  // correct answer has been revealed to the student, anything the client
  // later reports about that question is untrustworthy by construction. The
  // first recorded answer wins and cannot be overwritten, so a client that
  // answers wrong and then "submits" the right answer still scores zero.
  currentAttemptAnswers Json?
  // Seeds the per-attempt ORDERING option shuffle. Without it the GET
  // reshuffles on every request, so refreshing mid-quiz would visibly
  // re-order the options under an already-graded question. Answers are
  // recorded by option id, so correctness was never at risk — only display.
  currentAttemptSeed String?

  // Sprint 06C — Trap Hunter. The remedial pass over the mistakes of the
  // most recent COMPLETED attempt, shaped
  //   { sourceAttemptId, traps: { [questionId]: { attempts, hintLevel, clearedAt } } }
  //
  // Distinct from all three neighbours above, and the distinction is the
  // whole design: currentAttemptAnswers is the IN-FLIGHT quiz attempt,
  // lastAnswers/lastSubmitResult are the COMPLETED one, and this is the
  // correction round over that completed attempt's wrong answers. The traps
  // themselves are never stored — they are derived from
  // lastSubmitResult.results.filter(r => !r.isCorrect), so a trap can never
  // disagree with the attempt that produced it.
  //
  // Holding sourceAttemptId INSIDE the JSON makes a quiz retake
  // self-detecting without another column (the same trick Sprint 06B.5 used
  // for currentAttemptAnswers): once it stops matching lastClientAttemptId,
  // this state belongs to a superseded attempt and starts over.
  //
  // THIS IS THE ONLY FIELD TRAP HUNTER WRITES. score, maxScore,
  // attemptsCount, completedAt, lastAnswers, lastSubmitResult and
  // currentAttemptAnswers all belong to the quiz's own scoring; writing to
  // any of them from the correction round would be duplicated scoring, and
  // would let a student inflate a quiz result by grinding traps.
  trapHunterState Json?

  // Sprint 06B — CHANGED from the implicit default (Restrict) to Cascade.
  // Without this, test/test-fixture-sweep.ts's user-first sweep order makes
  // the FIRST e2e test that records a quiz attempt throw P2003 and poison
  // every later suite. UserWordProgress already uses exactly this pairing —
  // Cascade on the user (deleting a user's account may reasonably take
  // their own attempt history with it), Restrict on the content (`task`,
  // above — a quiz with real attempts cannot itself be deleted).
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task LessonTask @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId])
  // Sprint 09 — "how many stages did this user finish today". completedAt is
  // stamped once, when the task is first passed, and never re-stamped (see
  // QuizService.submitTask), so it is a true completion event for both QUIZ and
  // PRACTICE. The @@unique above only offers a userId prefix, which degrades to
  // scanning every task row this user has ever touched.
  @@index([userId, completedAt])
  @@map("lesson_task_progress")
}

// Sprint 07 — append-only attempt history for question-bearing tasks (QUIZ
// and PRACTICE alike; this table is task-type agnostic like the engine that
// writes it).
//
// Before this, a retake overwrote lastAnswers/lastSubmitResult on the progress
// row, so "Thử lại" destroyed the record of the attempt it replaced — even the
// student's BEST one, whose score survived as a scalar while the answers that
// earned it did not.
//
// OWNERSHIP (read this before adding a second writer):
//   * This table is the AUTHORITATIVE history. Rows are never updated and
//     never deleted while the task exists.
//   * LessonTaskProgress.score/maxScore/attemptsCount is a DERIVED CACHE —
//     MAX(accuracyPercent) and COUNT(*) over these rows. Rebuildable.
//   * LessonTaskProgress.lastSubmitResult/lastAnswers/lastClientAttemptId is a
//     HOT-PATH REPLAY CACHE, equal to the newest row's `result`.
// All three are written in the SAME transaction as the insert below, so they
// cannot diverge without a crash mid-transaction, which Postgres prevents.
//
// Collapsing lastSubmitResult into "newest attempt" is possible and was
// deliberately NOT done in Sprint 07: it refactors the most heavily tested
// path in the codebase for no behavioural gain.
model LessonTaskAttempt {
  id     String @id @default(uuid())
  userId String
  taskId String

  // There is deliberately NO attemptNumber column. It would have been
  // computed as `progress.attemptsCount + 1` inside the transaction, but under
  // Prisma's default ReadCommitted isolation two concurrent submits both read
  // the same count and would both write 1 — with no uniqueness to catch it.
  // Ordinality is derivable from submittedAt via the index below, which cannot
  // race.
  correctCount    Int
  totalCount      Int
  accuracyPercent Int
  passed          Boolean
  durationSeconds Int?

  // The exact SubmitQuizResponseDto body that was returned for this attempt.
  // Storing the whole response — not just the answers — is what makes any
  // attempt independently replayable, which is what lets the P2002 backstop in
  // QuizService.submitTask return a real historical result instead of a 500
  // when a client replays a clientAttemptId from two attempts ago.
  result Json

  submittedAt     DateTime @default(now())
  // The idempotency key, scoped per-user by the @@unique below rather than
  // globally — one user's key space can never collide with another's. Same
  // contract as WordReviewLog.clientReviewId (Sprint 04).
  clientAttemptId String

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict (default): a task with real attempt history cannot be deleted,
  // matching LessonTaskProgress.task. QuizService.deleteTask already refuses
  // with 409 when attempts exist, so this is a backstop, not the primary guard.
  task LessonTask @relation(fields: [taskId], references: [id])

  @@unique([userId, clientAttemptId])
  @@index([userId, taskId, submittedAt])
  // Serves the Sprint 07-D daily dashboard ("practice attempts today").
  @@index([userId, submittedAt])
  @@map("lesson_task_attempts")
}

model Vocabulary {
  id            String  @id @default(uuid())
  word          String
  pronunciation String?
  meaning       String
  example       String?
  audioUrl      String?
  imageUrl      String?
  partOfSpeech  String?
  level         Int

  createdAt DateTime @default(now())

  lessons LessonVocabulary[]

  @@map("vocabularies")
}

model LessonVocabulary {
  id         String @id @default(uuid())
  lessonId   String
  vocabId    String
  orderIndex Int

  lesson     Lesson     @relation(fields: [lessonId], references: [id])
  vocabulary Vocabulary @relation(fields: [vocabId], references: [id])

  @@unique([lessonId, vocabId])
  @@map("lesson_vocabularies")
}

model VocabLibrary {
  id          String   @id @default(uuid())
  name        String
  description String
  thumbnail   String?
  orderIndex  Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  decks VocabDeck[]

  @@map("vocab_libraries")
}

model VocabDeck {
  id          String     @id @default(uuid())
  libraryId   String
  name        String
  description String?
  thumbnail   String?
  cefrLevel   CefrLevel?
  orderIndex  Int
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  library   VocabLibrary    @relation(fields: [libraryId], references: [id])
  deckWords VocabDeckWord[]

  @@index([libraryId])
  @@map("vocab_decks")
}

model VocabWord {
  id           String     @id @default(uuid())
  text         String
  ipa          String?
  audioUrl     String?
  imageUrl     String?
  cefrLevel    CefrLevel?
  synonyms     String[]   @default([])
  antonyms     String[]   @default([])
  collocations String[]   @default([])
  wordFamily   String[]   @default([])
  source       WordSource @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  meanings  VocabWordMeaning[]
  examples  VocabWordExample[]
  deckWords VocabDeckWord[]

  // Sprint 04 (Learning Engine) — Restrict (the default; see the models
  // below), not Cascade: a word with any learning history cannot be
  // deleted at all. VocabWordService.remove() has an explicit pre-check
  // for this; these relations are the defense-in-depth backstop.
  progressRows UserWordProgress[]
  reviewLogs   WordReviewLog[]

  @@index([text])
  @@map("vocab_words")
}

model VocabWordMeaning {
  id           String        @id @default(uuid())
  wordId       String
  partOfSpeech PartOfSpeech?
  meaning      String
  orderIndex   Int
  createdAt    DateTime      @default(now())

  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("vocab_word_meanings")
}

model VocabWordExample {
  id          String   @id @default(uuid())
  wordId      String
  sentence    String
  translation String?
  orderIndex  Int
  createdAt   DateTime @default(now())

  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("vocab_word_examples")
}

model VocabDeckWord {
  id         String   @id @default(uuid())
  deckId     String
  wordId     String
  orderIndex Int
  createdAt  DateTime @default(now())

  deck VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id])

  @@unique([deckId, wordId])
  @@index([wordId])
  @@map("vocab_deck_words")
}

// Sprint 04 — Learning Engine (SRS). One row per (user, word): the
// authoritative, backend-owned scheduling state. See
// docs/adr/007-learning-engine-srs.md and
// docs/sprints/sprint-04-learning-engine.md for the full design rationale
// (algorithm choice, ownership decision, mastery definition).
model UserWordProgress {
  id     String @id @default(uuid())
  userId String
  wordId String

  state        LearningState @default(NEW)
  easeFactor   Float         @default(2.5)
  intervalDays Int           @default(0)
  repetitions  Int           @default(0)
  lapses       Int           @default(0)

  lastReviewedAt DateTime?
  nextReviewAt   DateTime  @default(now())
  firstLearnedAt DateTime?
  masteredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Optimistic-concurrency guard — every write increments this; a write
  // whose `where` includes a stale version affects zero rows and is
  // surfaced as a 409, never silently overwritten. See LearningService.
  version Int @default(0)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict (default, explicit here for clarity): a word with any
  // progress cannot be deleted. VocabWordService.remove() pre-checks this
  // explicitly for a clearer error message; this is the DB-level backstop.
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Restrict)

  reviewLogs WordReviewLog[]

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
  @@index([userId, state])
  @@index([wordId])
  // Sprint 09 — "new words learned today". A row is created lazily, on the
  // word's FIRST rating (see LearningService.attemptReview), so createdAt is
  // exactly the moment a word entered this user's vocabulary.
  //
  // This also serves LearningService.getDueReviews' own introducedTodayCount
  // query, which filters on the same two columns and until now leaned on the
  // userId prefix of [userId, nextReviewAt].
  @@index([userId, createdAt])
  @@map("user_word_progress")
}

// Sprint 04 — Learning Engine (SRS). Append-only: every review a user
// submits gets one row here, and no field is ever edited or deleted after
// creation (enforced by convention in LearningService, not a DB trigger —
// the same trust-the-service-layer posture as EmailVerificationToken's
// consumedAt-not-delete pattern). The full before/after snapshot on this
// row is what makes an idempotent replay of the same clientReviewId return
// the *original* recorded outcome rather than whatever UserWordProgress
// happens to look like by the time the replay arrives — see
// LearningService's idempotency design.
model WordReviewLog {
  id         String @id @default(uuid())
  userId     String
  wordId     String
  progressId String

  rating ReviewRating

  previousState        LearningState
  newState             LearningState
  previousIntervalDays Int
  newIntervalDays      Int
  previousDueAt        DateTime
  newDueAt             DateTime
  newEaseFactor        Float
  newRepetitions       Int
  newLapses            Int
  // The UserWordProgress.version value immediately after this review
  // committed — part of the response snapshot, not a live lookup.
  resultVersion Int

  practiceMode PracticeSource
  // Client-supplied correlation id — analytics only, never trusted for
  // scheduling or idempotency.
  sessionId String?
  // The idempotency key. Scoped per-user (see the @@unique below, not a
  // bare global @unique) so one user's key space can never collide with
  // another's.
  clientReviewId String
  // Persisted (nullable) for future analytics/FSRS-fitting use — never
  // read by the scheduler; response time does not influence scheduling.
  responseTimeMs Int?

  // Bumped only if the scheduler's interval/ease math changes, so a future
  // migration (e.g. to FSRS) can distinguish reviews scheduled under the
  // old algorithm from new ones.
  algorithmVersion Int      @default(1)
  reviewedAt       DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict (default, explicit here for clarity): deleting a word with any
  // review history would otherwise silently erase append-only audit/
  // analytics/FSRS-migration data — the exact bug this relation prevents.
  word     VocabWord        @relation(fields: [wordId], references: [id], onDelete: Restrict)
  progress UserWordProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([userId, clientReviewId])
  @@index([userId, reviewedAt])
  @@index([wordId])
  @@map("word_review_logs")
}
