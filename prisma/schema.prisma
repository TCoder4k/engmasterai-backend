datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

//// ===================== ENUMS =====================

enum UserRole {
  USER
  ADMIN
}

enum CourseType {
  GRAMMAR
  VOCABULARY
  LISTENING
}

enum LessonTaskType {
  VIDEO
  QUIZ
  // Sprint 06D — Advanced Practice: separately authored, harder, more
  // contextual questions that extend the lesson once the student can already
  // answer it directly.
  //
  // It is NOT a second quiz and NOT derived from the student's mistakes —
  // that is Trap Hunter, which stays derived from the QUIZ task alone. The
  // difference is the source of the content: Trap Hunter replays questions
  // the student got wrong, Advanced Practice presents questions an author
  // wrote for this purpose.
  //
  // Its questions are ordinary Question rows and its progress is an ordinary
  // LessonTaskProgress row keyed by THIS task's id. That is what keeps its
  // scoring structurally separate from the quiz's — a different taskId is a
  // different row, so "Practice never writes to the quiz's score" is a
  // property of the schema rather than a rule someone has to remember.
  PRACTICE
  // @deprecated Sprint 06B — these two are QUESTION types (see QuestionType
  // below), not task types; they leaked into this enum before the Lesson
  // Quiz Engine existed. Zero rows and zero code references as of Sprint
  // 06B. Kept rather than dropped — removing a Postgres enum value is
  // disruptive and buys nothing since nothing reads them. A quiz task is
  // always `QUIZ`; a question's own `type` says whether it's multiple
  // choice, true/false, fill-blank or ordering. "Quiz is one kind of
  // LessonTask; LessonTask is not a synonym for Quiz."
  ARRANGE
  TRUE_FALSE
}

// DEAD as of Sprint 07. Written exactly once in the whole backend
// (QuizService.answerTaskQuestion sets IN_PROGRESS) and NEVER set to
// COMPLETED — under ON_SUBMIT feedback the answer path never runs at all, so
// a fully-passed quiz keeps NOT_STARTED forever. `completedAt` is the real
// signal and always has been.
//
// Sprint 07 deliberately did NOT "fix" this by adding writes: nothing reads
// the column, and a stored status beside completedAt is a second
// representation of one fact — which is how it came to disagree in the first
// place. LessonStepProgress therefore has no status column and derives its
// state from timestamps instead. Removal of this column is scheduled with the
// deprecated-endpoint cleanup.
//
// DO NOT read or write this from new code.
enum TaskProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// Sprint 07 — the two lesson steps that are CONSUMED rather than answered.
// Deliberately not LessonTaskType values: a quiz/practice task carries
// questions and hangs off LessonTask, whereas a video and its theory notes
// are columns on Lesson itself (videoUrl, notes). Modelling these as tasks
// would need a contentless LessonTask row per lesson plus a backfill, and
// would create two disagreeing answers to "does this lesson have a video?"
// — lesson.videoUrl and the task row.
enum LessonStepKind {
  VIDEO
  THEORY
}

// Sprint 06B — Lesson Quiz Engine. Deliberately NOT open-ended: only types
// that can actually be graded (grade-question.ts) AND rendered (a per-type
// input component) may exist here, so no row can ever carry a type the
// student UI cannot display. Extensibility lives in code, not the schema —
// see grade-question.ts's GRADERS registry, which makes "add an enum value
// without a grader" a compile error, not a runtime 500 in front of a
// student. Adding a reserved type later is one grader + one input
// component + one `ALTER TYPE ... ADD VALUE` migration.
//
// RESERVED (not implemented — add together with their grader, never
// before): MATCHING, DRAG_DROP, IMAGE_CHOICE, AUDIO_CHOICE, SHORT_ANSWER.
enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_BLANK
  ORDERING
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

// Sprint 06B.5 — when a quiz tells the student whether they were right.
//
// IMMEDIATE: grade each answer as it is given, reveal the correct answer and
//   the authored explanation straight away, then lock that question. Built
//   for LEARNING — a student who is wrong finds out while the question is
//   still in their head.
// ON_SUBMIT: the Sprint 06B behaviour — answer everything, submit once, see
//   the verdict at the end. Built for ASSESSMENT (a timed mock exam).
//
// This is a property of the QUIZ, never of the course type. Nothing in the
// quiz engine branches on CourseType — a Grammar lesson is IMMEDIATE because
// its author chose that, not because the engine knows what Grammar is.
enum QuizFeedbackMode {
  IMMEDIATE
  ON_SUBMIT
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

// Personalized Onboarding & Placement Test — the six goal choices offered on
// the onboarding wizard's first step. Closed on purpose, same discipline as
// CourseType: a new goal needs a migration, not a free-text column.
enum LearningGoal {
  FOUNDATION
  TOEIC_450
  TOEIC_650
  TOEIC_800
  GENERAL_ENGLISH
  REGULAR_PRACTICE
}

// How Roadmap.estimatedLevel was arrived at. Not the same thing as whether
// estimatedLevel is null: BEGINNER_ASSUMED still carries a real level ('A1')
// so the roadmap algorithm can use level-aware course selection instead of
// its blind "oldest course wins" fallback — but there are no real section
// scores behind it, unlike TEST_GRADED. buildReason()/the consolidation
// phase both need to tell these apart to avoid describing an assumed
// baseline as if it were a measured "weakest section (X%)".
enum LevelSource {
  BEGINNER_ASSUMED
  TEST_GRADED
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PRONOUN
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  PHRASE
  IDIOM
}

enum WordSource {
  ADMIN
  IMPORT
  AI
}

// Sprint 04 — Learning Engine (SRS). See docs/adr/007-learning-engine-srs.md.
enum LearningState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
  MASTERED
  // SUSPENDED deliberately omitted — no code path sets it in Sprint 04;
  // added via its own migration if a future "stop reviewing this word"
  // feature is designed.
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum PracticeSource {
  FLASHCARD
  DICTATION
  REVIEW
  // GAMES deliberately absent — Games never submits SRS reviews (Sprint 04 scope).
}

//// ===================== MODELS =====================
//
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String? // nullable: Google-only accounts (Sprint 02A) have no local password
  name      String
  avatarUrl String? //can be null
  role      UserRole @default(USER)

  // Sprint 10 (Gamification) — BOTH OF THESE ARE CACHES, and that is the whole
  // point of the design. XpTransaction is the single source of truth:
  //
  //   totalPoints  == SUM(XpTransaction.amount) for this user
  //   level        == levelForXp(totalPoints)   -- a pure function
  //
  // Both are therefore REBUILDABLE from the ledger with one query and one pure
  // call. That property is why the ledger exists at all: a running total with
  // no event log behind it turns every awarding bug into permanent, unfixable
  // data loss.
  //
  // Written ONLY by GamificationService.awardXp, always as
  // `{ increment }` inside the caller's transaction — never read-modify-write.
  // (UserService.updatePoints did exactly that and was deleted in Sprint 10;
  // two concurrent awards would silently lose one.)
  //
  // KNOWN GAP, deliberate: the admin PUT /users/:id path can still set these
  // directly, which desynchronises them from the ledger with nothing to detect
  // it. It sits behind @Roles(ADMIN) so it is not a student-reachable path.
  // The correct fix later is an ADMIN_ADJUSTMENT ledger row.
  totalPoints Int @default(0)
  level       Int @default(1)

  createdAt       DateTime  @default(now())
  // Set only when the backend has cryptographically verified email ownership
  // (currently: a successful Google ID-token verification with
  // email_verified=true, at account-creation or account-linking time).
  // Sprint 02A writes this field; nothing reads or branches on it yet — it
  // exists so a future local-email-verification sprint (02B) inherits
  // accurate data with no backfill guesswork. NULL for every pre-existing
  // local account, which is accurate: their email ownership was never
  // verified.
  emailVerifiedAt DateTime?

  // Sprint 04 (Learning Engine): set at most once from a client-supplied
  // bootstrap value (see LearningService) — never re-derived per request,
  // so a user can't reset their daily new-word quota by spoofing a
  // different timezone on each call. NULL means "not yet learned" and all
  // day-bucketing falls back to UTC.
  timezone String?

  // Personalized Onboarding & Placement Test. `learningGoal` is a simple
  // current-value field, same shape as `timezone` above — no history, freely
  // overwritable via PUT /placement/goal.
  //
  // `onboardedAt` is the ONE gate signal, same shape as `emailVerifiedAt`
  // above: a historical "when did X happen" timestamp, never a synced status
  // enum. Set exactly once, inside the finalize step that successfully
  // generates a Roadmap (either the beginner-skip path or a graded placement
  // submit) — never re-set afterward. The migration that introduces this
  // column backfills it to `createdAt` for every pre-existing row, so no
  // account that predates this feature is ever gated into onboarding; a NULL
  // value means "genuinely hasn't onboarded yet," never "predates the
  // feature." GET /users/me derives `onboarded: onboardedAt !== null` the
  // same way it already derives `emailVerified`.
  learningGoal LearningGoal?
  onboardedAt  DateTime?

  taskProgress            LessonTaskProgress[]
  taskAttempts            LessonTaskAttempt[]
  stepProgress            LessonStepProgress[]
  identities              AuthIdentity[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  wordProgress            UserWordProgress[]
  wordReviewLogs          WordReviewLog[]
  xpTransactions          XpTransaction[]
  dailyActivity           UserDailyActivity[]
  studyTimeEvents         StudyTimeEvent[]

  dictationSegmentProgress ListeningDictationSegmentProgress[]
  dictationAttempts        ListeningDictationAttempt[]
  shadowingSegmentProgress ListeningShadowingSegmentProgress[]
  shadowingAttempts        ListeningShadowingAttempt[]

  guessWordProgress VocabGuessProgress[]

  placementAttempts PlacementAttempt[]
  roadmap           Roadmap?

  @@map("users") //users dùng cho query sql , còn User dùng cho code
}

enum AuthProvider {
  GOOGLE
}

// One row per external identity provider linked to a User (Sprint 02A). A
// separate table (not googleId/provider columns on User) so one account can
// hold multiple provider identities without nullable-column sprawl as more
// providers are added later.
model AuthIdentity {
  id     String @id @default(uuid())
  userId String

  provider        AuthProvider
  providerSubject String // Google's `sub` claim — stable, opaque, never the email
  providerEmail   String // verified email at link time — audit trail only, never a login key

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

// Single-use, expiring, opaque token proving control of a local account's
// email inbox (Sprint 02B). Only a SHA-256 hash of the token is ever stored
// — see src/auth/tokens/secure-token.util.ts. Issuing a new token for a user
// invalidates every previous outstanding one (AuthService.resendVerification/
// register set every prior unconsumed row's consumedAt before inserting the
// new row, in the same transaction).
model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Single-use, expiring, opaque token proving legitimate password-reset intent
// (Sprint 02C). Same generation/hashing/consumption mechanics as
// EmailVerificationToken (see src/auth/tokens/secure-token.util.ts) but a
// separate table — the two token types carry different operational policies
// (reset triggers full session revocation and treats replay as a security
// signal; verification does neither). A successful reset consumes every
// outstanding row for the user (not only the one presented) and, per ADR 006
// Invariant 1, also consumes every outstanding EmailVerificationToken row for
// that user in the same transaction.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Course {
  id          String     @id @default(uuid())
  title       String
  type        CourseType
  description String
  thumbnail   String?
  isPublished Boolean    @default(false)

  // Personalized Onboarding & Placement Test — admin-settable, optional.
  // Lets the roadmap algorithm match a placement result's weak sections to
  // an appropriately-leveled course. Reuses the existing CefrLevel enum
  // (already used by VocabDeck/VocabWord/ListeningContent) rather than
  // inventing a course-specific scale. Until an admin sets this, the roadmap
  // falls back to ordering by createdAt (see roadmap-algorithm.ts) — the
  // same implicit "earlier-authored = more foundational" assumption
  // GrammarCourseCard's title-regex level parsing already makes.
  level CefrLevel?

  // Personalized Onboarding & Placement Test — admin-settable, optional,
  // closed set (same discipline as LearningGoal itself: a new goal needs a
  // migration, not a free-text column). Empty means "eligible for every
  // goal" — today's implicit behavior — so an untagged course (every course
  // as of this field's introduction) stays a candidate for everyone rather
  // than silently dropping out of every roadmap until an admin tags it.
  suitableGoals LearningGoal[] @default([])

  createdAt DateTime @default(now())

  lessons Lesson[]

  @@map("courses")
}

model Lesson {
  id          String  @id @default(uuid())
  courseId    String
  title       String
  description String?
  notes       String?

  videoUrl              String?
  pdfUrl                String?
  audioUrl              String?
  videoDurationMinutes  Int?
  estimatedStudyMinutes Int?
  learningObjectives    String[] @default([])

  orderIndex  Int
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course       Course               @relation(fields: [courseId], references: [id])
  tasks        LessonTask[]
  vocabularies LessonVocabulary[]
  stepProgress LessonStepProgress[]

  @@index([courseId])
  @@map("lessons")
}

// Sprint 07 — durable progress for the VIDEO and THEORY steps. Before this,
// both lived ONLY in the browser's localStorage, which made two of the five
// stages that gate lesson completion device-local, client-forgeable and
// invisible to the server: a lesson finished on a laptop read as unfinished
// on a phone, permanently.
model LessonStepProgress {
  id       String         @id @default(uuid())
  userId   String
  lessonId String
  step     LessonStepKind

  // There is NO status enum here, and that is deliberate — see the note on
  // TaskProgressStatus. State is derived from these two timestamps:
  //   completedAt != null -> COMPLETED
  //   startedAt   != null -> IN_PROGRESS
  //   neither             -> NOT_STARTED
  // One fact, one representation, nothing that can disagree with itself.
  startedAt   DateTime?
  // Set once and NEVER cleared by any code path. Rewatching a finished video
  // or reopening finished theory updates lastActivityAt only — a review must
  // never cost a student their completion.
  completedAt DateTime?

  // Written explicitly by the service, not via @updatedAt: @updatedAt would
  // fire on every write and mean "last written", which for THEORY (whose only
  // writes are start and complete) is not the same thing as "last accessed".
  lastActivityAt DateTime @default(now())

  // VIDEO only; null for THEORY. Monotonic — the service takes max(stored,
  // reported), so seeking backwards or replaying can never lower it.
  highestPositionSeconds Int?
  // WRITE-ONCE. Captured from the first report that carries a usable duration
  // and never updated afterwards.
  //
  // This is the anti-abuse floor for the 90% completion gate. The gate has no
  // anti-seek rule by product decision (dragging to the end completes the
  // step), but without freezing the denominator a later {positionSeconds: 1,
  // durationSeconds: 1} payload would complete any video whose lesson has no
  // authored videoDurationMinutes — which is most of them, since the column
  // is nullable.
  videoDurationSeconds   Int?

  // Cascade on both sides. The user side matches LessonTaskProgress and
  // UserWordProgress (deleting an account takes its own progress with it).
  //
  // The lesson side deliberately DIVERGES from LessonTaskProgress.task, which
  // is Restrict so a quiz with real attempts cannot be deleted. A watch
  // position is not graded work, and Restrict here would make the existing
  // admin DELETE /lessons/:id start throwing P2003 for any lesson a student
  // had merely opened — a behaviour change well outside Sprint 07's scope.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId, step])
  // Serves the Sprint 07-D daily dashboard ("lessons completed today") without
  // needing a second index later.
  @@index([userId, completedAt])
  // Sprint 09 — the activity calendar / streak window, which asks "did this
  // user touch anything on day N". completedAt above cannot answer it: a
  // student who watched half a video today completed nothing, but the day is
  // still an active day. lastActivityAt is the only column that moves on every
  // visit, so it is the one the streak reads.
  @@index([userId, lastActivityAt])
  @@map("lesson_step_progress")
}

model LessonTask {
  id         String         @id @default(uuid())
  lessonId   String
  type       LessonTaskType
  title      String
  content    Json
  points     Int
  orderIndex Int

  // Sprint 06B — a quiz with unsaved/incomplete authoring must not reach
  // students. Defaults false: an admin has to explicitly publish, mirroring
  // Lesson.isPublished's own default.
  isPublished         Boolean @default(false)
  // Null falls back to the QUIZ_DEFAULT_PASSING_SCORE_PERCENT env default
  // (see QuizService) — never hardcoded per the sprint spec.
  passingScorePercent Int?

  // Sprint 06B.5 — see QuizFeedbackMode. Defaults to IMMEDIATE because the
  // lessons this engine serves today are for learning, not examination; an
  // author picks ON_SUBMIT explicitly when they want a test.
  feedbackMode QuizFeedbackMode @default(IMMEDIATE)

  createdAt DateTime @default(now())

  // Restrict (default, explicit here for clarity): a task with real student
  // attempts (LessonTaskProgress rows) cannot be deleted, only unpublished —
  // same reasoning as UserWordProgress's word relation. This is also what
  // keeps `Lesson.remove()`'s existing "cannot delete a lesson with tasks"
  // guard meaningful.
  lesson    Lesson               @relation(fields: [lessonId], references: [id])
  questions Question[]
  progress  LessonTaskProgress[]
  attempts  LessonTaskAttempt[]

  // Sprint 06D — one task of each kind per lesson. Every lookup in the
  // engine is `findFirst({ where: { lessonId, type, isPublished } })` with no
  // `orderBy`, so before this constraint two rows of the same type on one
  // lesson meant the student silently got whichever Postgres returned first —
  // and could get a different one on the next request. Verified duplicate-free
  // on both databases before adding (0 groups across 4 dev rows / 0 test).
  //
  // This also makes the admin whole-document upsert honest: it must UPDATE the
  // existing task rather than insert a second one, and now fails loudly
  // instead of quietly creating an ambiguity nobody would notice until a
  // student saw the wrong quiz.
  @@unique([lessonId, type])
  @@map("lesson_tasks")
}

model Question {
  id            String              @id @default(uuid())
  taskId        String
  content       String
  // Sprint 06B — required; every question authored from this sprint forward
  // must declare its grading shape. See grade-question.ts for the per-type
  // options/correctAnswer contract this drives.
  type          QuestionType        @default(MULTIPLE_CHOICE)
  difficulty    QuestionDifficulty?
  options       Json?
  correctAnswer Json
  explanation   String?
  audioUrl      String?
  imageUrl      String?
  orderIndex    Int

  task LessonTask @relation(fields: [taskId], references: [id])

  @@map("questions")
}

//Một user có thể có nhiều tiến độ làm bài
model LessonTaskProgress {
  id            String             @id @default(uuid())
  userId        String
  taskId        String
  status        TaskProgressStatus @default(NOT_STARTED)
  score         Int                @default(0)
  maxScore      Int
  attemptsCount Int                @default(0)
  completedAt   DateTime?

  // Sprint 06B — stamped by the quiz GET when no attempt is currently in
  // flight; submit() computes elapsed time as `now - attemptStartedAt`, so
  // the number reflects real time spent and survives a mid-quiz refresh
  // (the GET does not re-stamp an in-flight attempt).
  attemptStartedAt    DateTime?
  // Null when the gap since attemptStartedAt exceeds a sane cap (a tab left
  // open overnight) — the summary omits the row rather than showing a
  // fabricated number, the same rule Sprint 06A uses for absent content
  // blocks.
  lastDurationSeconds Int?

  // Idempotency for POST .../quiz/submit, scoped to this (user, task) row —
  // no separate per-attempt log table exists, so a retried submission is
  // recognised by comparing against the MOST RECENT attempt only (same
  // "replay the original recorded outcome" contract as Sprint 04's
  // WordReviewLog, sized down: one prior attempt of memory instead of an
  // append-only history, which this feature does not need). A resubmission
  // with the same lastClientAttemptId but different answers is a conflict
  // (QuizIdempotencyConflictException, never silently re-graded); the same
  // id with the same answers replays lastSubmitResult verbatim rather than
  // re-computing it.
  lastClientAttemptId String?
  lastAnswers         Json?
  lastSubmitResult    Json?

  // Sprint 06B.5 — the IN-FLIGHT attempt's server-graded answers, shaped
  //   { [questionId]: { submitted, isCorrect, answeredAt } }
  // Deliberately distinct from lastAnswers/lastSubmitResult above, which
  // record the most recent COMPLETED attempt for idempotent replay.
  //
  // This is the ONLY input to scoring under IMMEDIATE feedback, and that is
  // a security property, not an implementation detail: once a question's
  // correct answer has been revealed to the student, anything the client
  // later reports about that question is untrustworthy by construction. The
  // first recorded answer wins and cannot be overwritten, so a client that
  // answers wrong and then "submits" the right answer still scores zero.
  currentAttemptAnswers Json?
  // Seeds the per-attempt ORDERING option shuffle. Without it the GET
  // reshuffles on every request, so refreshing mid-quiz would visibly
  // re-order the options under an already-graded question. Answers are
  // recorded by option id, so correctness was never at risk — only display.
  currentAttemptSeed    String?

  // Sprint 06C — Trap Hunter. The remedial pass over the mistakes of the
  // most recent COMPLETED attempt, shaped
  //   { sourceAttemptId, traps: { [questionId]: { attempts, hintLevel, clearedAt } } }
  //
  // Distinct from all three neighbours above, and the distinction is the
  // whole design: currentAttemptAnswers is the IN-FLIGHT quiz attempt,
  // lastAnswers/lastSubmitResult are the COMPLETED one, and this is the
  // correction round over that completed attempt's wrong answers. The traps
  // themselves are never stored — they are derived from
  // lastSubmitResult.results.filter(r => !r.isCorrect), so a trap can never
  // disagree with the attempt that produced it.
  //
  // Holding sourceAttemptId INSIDE the JSON makes a quiz retake
  // self-detecting without another column (the same trick Sprint 06B.5 used
  // for currentAttemptAnswers): once it stops matching lastClientAttemptId,
  // this state belongs to a superseded attempt and starts over.
  //
  // THIS IS THE ONLY FIELD TRAP HUNTER WRITES. score, maxScore,
  // attemptsCount, completedAt, lastAnswers, lastSubmitResult and
  // currentAttemptAnswers all belong to the quiz's own scoring; writing to
  // any of them from the correction round would be duplicated scoring, and
  // would let a student inflate a quiz result by grinding traps.
  trapHunterState Json?

  // Sprint 06B — CHANGED from the implicit default (Restrict) to Cascade.
  // Without this, test/test-fixture-sweep.ts's user-first sweep order makes
  // the FIRST e2e test that records a quiz attempt throw P2003 and poison
  // every later suite. UserWordProgress already uses exactly this pairing —
  // Cascade on the user (deleting a user's account may reasonably take
  // their own attempt history with it), Restrict on the content (`task`,
  // above — a quiz with real attempts cannot itself be deleted).
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task LessonTask @relation(fields: [taskId], references: [id])

  @@unique([userId, taskId])
  // Sprint 09 — "how many stages did this user finish today". completedAt is
  // stamped once, when the task is first passed, and never re-stamped (see
  // QuizService.submitTask), so it is a true completion event for both QUIZ and
  // PRACTICE. The @@unique above only offers a userId prefix, which degrades to
  // scanning every task row this user has ever touched.
  @@index([userId, completedAt])
  @@map("lesson_task_progress")
}

// Sprint 07 — append-only attempt history for question-bearing tasks (QUIZ
// and PRACTICE alike; this table is task-type agnostic like the engine that
// writes it).
//
// Before this, a retake overwrote lastAnswers/lastSubmitResult on the progress
// row, so "Thử lại" destroyed the record of the attempt it replaced — even the
// student's BEST one, whose score survived as a scalar while the answers that
// earned it did not.
//
// OWNERSHIP (read this before adding a second writer):
//   * This table is the AUTHORITATIVE history. Rows are never updated and
//     never deleted while the task exists.
//   * LessonTaskProgress.score/maxScore/attemptsCount is a DERIVED CACHE —
//     MAX(accuracyPercent) and COUNT(*) over these rows. Rebuildable.
//   * LessonTaskProgress.lastSubmitResult/lastAnswers/lastClientAttemptId is a
//     HOT-PATH REPLAY CACHE, equal to the newest row's `result`.
// All three are written in the SAME transaction as the insert below, so they
// cannot diverge without a crash mid-transaction, which Postgres prevents.
//
// Collapsing lastSubmitResult into "newest attempt" is possible and was
// deliberately NOT done in Sprint 07: it refactors the most heavily tested
// path in the codebase for no behavioural gain.
model LessonTaskAttempt {
  id     String @id @default(uuid())
  userId String
  taskId String

  // There is deliberately NO attemptNumber column. It would have been
  // computed as `progress.attemptsCount + 1` inside the transaction, but under
  // Prisma's default ReadCommitted isolation two concurrent submits both read
  // the same count and would both write 1 — with no uniqueness to catch it.
  // Ordinality is derivable from submittedAt via the index below, which cannot
  // race.
  correctCount    Int
  totalCount      Int
  accuracyPercent Int
  passed          Boolean
  durationSeconds Int?

  // The exact SubmitQuizResponseDto body that was returned for this attempt.
  // Storing the whole response — not just the answers — is what makes any
  // attempt independently replayable, which is what lets the P2002 backstop in
  // QuizService.submitTask return a real historical result instead of a 500
  // when a client replays a clientAttemptId from two attempts ago.
  result Json

  submittedAt     DateTime @default(now())
  // The idempotency key, scoped per-user by the @@unique below rather than
  // globally — one user's key space can never collide with another's. Same
  // contract as WordReviewLog.clientReviewId (Sprint 04).
  clientAttemptId String

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict (default): a task with real attempt history cannot be deleted,
  // matching LessonTaskProgress.task. QuizService.deleteTask already refuses
  // with 409 when attempts exist, so this is a backstop, not the primary guard.
  task LessonTask @relation(fields: [taskId], references: [id])

  @@unique([userId, clientAttemptId])
  @@index([userId, taskId, submittedAt])
  // Serves the Sprint 07-D daily dashboard ("practice attempts today").
  @@index([userId, submittedAt])
  @@map("lesson_task_attempts")
}

model Vocabulary {
  id            String  @id @default(uuid())
  word          String
  pronunciation String?
  meaning       String
  example       String?
  audioUrl      String?
  imageUrl      String?
  partOfSpeech  String?
  level         Int

  createdAt DateTime @default(now())

  lessons LessonVocabulary[]

  @@map("vocabularies")
}

model LessonVocabulary {
  id         String @id @default(uuid())
  lessonId   String
  vocabId    String
  orderIndex Int

  lesson     Lesson     @relation(fields: [lessonId], references: [id])
  vocabulary Vocabulary @relation(fields: [vocabId], references: [id])

  @@unique([lessonId, vocabId])
  @@map("lesson_vocabularies")
}

model VocabLibrary {
  id          String   @id @default(uuid())
  name        String
  description String
  thumbnail   String?
  orderIndex  Int
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Personalized Roadmap (multi-pillar) — mirrors Course.level/suitableGoals
  // exactly (see Course's own schema comments). Lets the roadmap algorithm
  // match a placement result's weak Vocabulary section to an appropriately-
  // leveled library, and restrict candidates to goals it's actually authored
  // for. Empty suitableGoals = eligible for every goal, matching
  // Course.suitableGoals's own default so an untagged library (as of this
  // field's introduction) stays a candidate for everyone rather than
  // silently dropping out of every roadmap until an admin tags it.
  level         CefrLevel?
  suitableGoals LearningGoal[] @default([])

  decks VocabDeck[]

  @@map("vocab_libraries")
}

model VocabDeck {
  id          String     @id @default(uuid())
  libraryId   String
  name        String
  description String?
  thumbnail   String?
  cefrLevel   CefrLevel?
  orderIndex  Int
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  library   VocabLibrary    @relation(fields: [libraryId], references: [id])
  deckWords VocabDeckWord[]

  guessProgress VocabGuessProgress[]

  @@index([libraryId])
  @@map("vocab_decks")
}

model VocabWord {
  id           String     @id @default(uuid())
  text         String
  ipa          String?
  audioUrl     String?
  imageUrl     String?
  cefrLevel    CefrLevel?
  synonyms     String[]   @default([])
  antonyms     String[]   @default([])
  collocations String[]   @default([])
  wordFamily   String[]   @default([])
  source       WordSource @default(ADMIN)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  meanings  VocabWordMeaning[]
  examples  VocabWordExample[]
  deckWords VocabDeckWord[]

  // Sprint 04 (Learning Engine) — Restrict (the default; see the models
  // below), not Cascade: a word with any learning history cannot be
  // deleted at all. VocabWordService.remove() has an explicit pre-check
  // for this; these relations are the defense-in-depth backstop.
  progressRows UserWordProgress[]
  reviewLogs   WordReviewLog[]

  // Sprint — persistent Guess-the-Word progress (per deck, not per word —
  // see VocabGuessProgress). Restrict for the same reason as
  // progressRows/reviewLogs above: a word with any learning history cannot
  // be deleted at all.
  guessProgress VocabGuessProgress[]

  @@index([text])
  @@map("vocab_words")
}

model VocabWordMeaning {
  id           String        @id @default(uuid())
  wordId       String
  partOfSpeech PartOfSpeech?
  meaning      String
  orderIndex   Int
  createdAt    DateTime      @default(now())

  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("vocab_word_meanings")
}

model VocabWordExample {
  id          String   @id @default(uuid())
  wordId      String
  sentence    String
  translation String?
  orderIndex  Int
  createdAt   DateTime @default(now())

  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([wordId])
  @@map("vocab_word_examples")
}

model VocabDeckWord {
  id         String   @id @default(uuid())
  deckId     String
  wordId     String
  orderIndex Int
  createdAt  DateTime @default(now())

  deck VocabDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id])

  @@unique([deckId, wordId])
  @@index([wordId])
  @@map("vocab_deck_words")
}

// Persistent, per-deck progress for the "Guess the Word" vocabulary
// practice mode. Deliberately NOT the SRS engine below (UserWordProgress /
// WordReviewLog): no easeFactor/interval/due-date, and scoped per
// (user, deck, word) rather than UserWordProgress's global per (user, word)
// key, because the same word can appear in multiple decks and this mode's
// "learned" concept is explicitly per-deck (confirmed with the product
// owner). A correct answer is a naturally idempotent upsert — setting
// learnedAt when it is already set is a no-op — so none of
// UserWordProgress's version-conflict/idempotency-key machinery is needed
// here, and a wrong/skipped answer needs no write at all: the absence of a
// row already means "not learned". See VocabDeckService's guess-progress
// methods.
model VocabGuessProgress {
  id     String @id @default(uuid())
  userId String
  deckId String
  wordId String

  // Set once, on the first correct answer, and never cleared except by an
  // explicit whole-deck reset ("Học lại toàn bộ", which DELETES rows for
  // this (user, deck) pair rather than clearing the field — see
  // VocabDeckService.resetGuessProgress) — same sticky contract as
  // LessonStepProgress.completedAt.
  learnedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck VocabDeck @relation(fields: [deckId], references: [id], onDelete: Restrict)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Restrict)

  @@unique([userId, deckId, wordId])
  @@index([userId, deckId])
  @@map("vocab_guess_progress")
}

// Sprint 04 — Learning Engine (SRS). One row per (user, word): the
// authoritative, backend-owned scheduling state. See
// docs/adr/007-learning-engine-srs.md and
// docs/sprints/sprint-04-learning-engine.md for the full design rationale
// (algorithm choice, ownership decision, mastery definition).
model UserWordProgress {
  id     String @id @default(uuid())
  userId String
  wordId String

  state        LearningState @default(NEW)
  easeFactor   Float         @default(2.5)
  intervalDays Int           @default(0)
  repetitions  Int           @default(0)
  lapses       Int           @default(0)

  lastReviewedAt DateTime?
  nextReviewAt   DateTime  @default(now())
  firstLearnedAt DateTime?
  masteredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Optimistic-concurrency guard — every write increments this; a write
  // whose `where` includes a stale version affects zero rows and is
  // surfaced as a 409, never silently overwritten. See LearningService.
  version   Int      @default(0)

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict (default, explicit here for clarity): a word with any
  // progress cannot be deleted. VocabWordService.remove() pre-checks this
  // explicitly for a clearer error message; this is the DB-level backstop.
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Restrict)

  reviewLogs WordReviewLog[]

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
  @@index([userId, state])
  @@index([wordId])
  // Sprint 09 — "new words learned today". A row is created lazily, on the
  // word's FIRST rating (see LearningService.attemptReview), so createdAt is
  // exactly the moment a word entered this user's vocabulary.
  //
  // This also serves LearningService.getDueReviews' own introducedTodayCount
  // query, which filters on the same two columns and until now leaned on the
  // userId prefix of [userId, nextReviewAt].
  @@index([userId, createdAt])
  @@map("user_word_progress")
}

// Sprint 04 — Learning Engine (SRS). Append-only: every review a user
// submits gets one row here, and no field is ever edited or deleted after
// creation (enforced by convention in LearningService, not a DB trigger —
// the same trust-the-service-layer posture as EmailVerificationToken's
// consumedAt-not-delete pattern). The full before/after snapshot on this
// row is what makes an idempotent replay of the same clientReviewId return
// the *original* recorded outcome rather than whatever UserWordProgress
// happens to look like by the time the replay arrives — see
// LearningService's idempotency design.
model WordReviewLog {
  id         String @id @default(uuid())
  userId     String
  wordId     String
  progressId String

  rating ReviewRating

  previousState        LearningState
  newState             LearningState
  previousIntervalDays Int
  newIntervalDays      Int
  previousDueAt        DateTime
  newDueAt             DateTime
  newEaseFactor        Float
  newRepetitions       Int
  newLapses            Int
  // The UserWordProgress.version value immediately after this review
  // committed — part of the response snapshot, not a live lookup.
  resultVersion        Int

  practiceMode   PracticeSource
  // Client-supplied correlation id — analytics only, never trusted for
  // scheduling or idempotency.
  sessionId      String?
  // The idempotency key. Scoped per-user (see the @@unique below, not a
  // bare global @unique) so one user's key space can never collide with
  // another's.
  clientReviewId String
  // Persisted (nullable) for future analytics/FSRS-fitting use — never
  // read by the scheduler; response time does not influence scheduling.
  responseTimeMs Int?

  // Bumped only if the scheduler's interval/ease math changes, so a future
  // migration (e.g. to FSRS) can distinguish reviews scheduled under the
  // old algorithm from new ones.
  algorithmVersion Int      @default(1)
  reviewedAt       DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict (default, explicit here for clarity): deleting a word with any
  // review history would otherwise silently erase append-only audit/
  // analytics/FSRS-migration data — the exact bug this relation prevents.
  word     VocabWord        @relation(fields: [wordId], references: [id], onDelete: Restrict)
  progress UserWordProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@unique([userId, clientReviewId])
  @@index([userId, reviewedAt])
  @@index([wordId])
  @@map("word_review_logs")
}

// Sprint 10 — Gamification.
//
// SIX values. There is deliberately NO STREAK_MILESTONE: a day streak is
// rewarded THROUGH the STREAK_3 / STREAK_7 achievements, not through a second
// XP source beside them. One event -> one reward -> one ledger row. An earlier
// draft had both and would have written two rows for the same moment.
enum XpSource {
  STAGE_COMPLETED // video / theory finished
  TASK_PASSED // quiz / practice, FIRST pass only
  TRAP_CLEARED
  WORD_REVIEWED
  WORD_MASTERED
  ACHIEVEMENT
}

// The append-only XP ledger — the SINGLE SOURCE OF TRUTH for points, and also
// the record of when each achievement was unlocked.
//
// WHY A LEDGER AND NOT A COUNTER. Every other progress model in this codebase
// answers "what is the state now" and can be recomputed from its own rows at
// any time. XP is an ACCUMULATION: without an event log, User.totalPoints is a
// number nobody can rebuild, and every awarding bug becomes permanent silent
// data loss. Sprint 10 exists on top of three sprints of progress corrections,
// which is exactly the situation where that matters.
//
// EXACTLY-ONCE IS ENFORCED BY THE DATABASE, not by application checks.
// @@unique([userId, sourceKey]) plus createManyAndReturn({ skipDuplicates })
// (-> ON CONFLICT DO NOTHING ... RETURNING *) means a replayed request inserts
// nothing and returns nothing, so the caller adds 0 and the student is not
// paid twice. This is the same contract LessonTaskAttempt.clientAttemptId and
// WordReviewLog.clientReviewId already use, one layer down.
//
// It also has to be conflict-free rather than caught: a failed statement
// aborts the whole Postgres transaction and Prisma exposes no savepoint, so a
// try/catch around the insert could not recover — see the long note in
// QuizService.submitTask, which learned this the hard way.
//
// sourceKey IS SERVER-BUILT AND NEVER CLIENT-SUPPLIED, and its FORMAT IS A
// PERMANENT CONTRACT: changing `step:{lessonId}:VIDEO` to anything else after
// deploy would make every past award un-matchable and re-award the lot. It is
// pinned by literal-string assertions in xp-rules.spec.ts for that reason.
// It is scoped per-user by the unique below, so it never carries a userId.
//
// There is no `metadata` column. sourceKey already carries the lesson/task/
// word id it would have held, and no Sprint 10 consumer reads anything else.
model XpTransaction {
  id        String   @id @default(uuid())
  userId    String
  amount    Int
  source    XpSource
  sourceKey String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceKey])
  @@index([userId, createdAt])
  // Serves the profile snapshot's single achievement query
  // (source = ACHIEVEMENT), which doubles as the unlock record: the row's
  // createdAt IS unlockedAt. That is why no UserAchievement table exists —
  // it would have duplicated this row's uniqueness, timestamp and listing.
  // The design holds only while EVERY achievement grants xp > 0 (a 0-XP
  // achievement would write no row and be invisible); achievement-catalog.spec
  // asserts exactly that.
  @@index([userId, source])
  @@map("xp_transactions")
}

// One row per (user, calendar day on which they did something).
//
// WRITTEN BY SPRINT 10, READ BY A LATER SPRINT. Nothing in Sprint 10 reads
// this table for display — GET /analytics/dashboard keeps its existing
// three-table scan untouched, because this table is empty at deploy and
// switching the read over would blank the streak and the 7-day calendar for
// every existing account. Sprint 09's streak is live; resetting it would be a
// regression, not a fresh start (XP starting at zero is honest, a streak
// dropping to zero is not).
//
// Its one Sprint 10 consumer is internal: creating a row is the trigger that
// says "this is the first activity of a new day", which is when — and only
// when — streak milestones are evaluated. See GamificationService.
//
// LessonTaskAttempt spent Sprint 07->08 in exactly this write-only state, kept
// honest by an e2e test on the rows; this follows that precedent. Writing from
// day one means the sprint that widens the streak past 7 days inherits real
// history and needs no backfill.
//
// `day` IS BUCKETED AT WRITE TIME using the user's timezone, and never
// re-derived on read. A day on which someone studied is a historical fact;
// flying to another timezone does not move last Tuesday. It must be built only
// via dayKeyToDate() — `new Date(...)` on a date string is UTC midnight, which
// is the exact class of bug Sprint 09 found and fixed in startOfDayInTimeZone.
model UserDailyActivity {
  id     String   @id @default(uuid())
  userId String
  day    DateTime @db.Date

  // The zone `day` was bucketed with. Not used to recompute anything — kept so
  // the later read-side sprint can tell a UTC-bucketed row (written before the
  // user's timezone was ever learned) from a real one.
  timeZone String

  firstActivityAt DateTime
  lastActivityAt  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("user_daily_activity")
}

// Sprint 10.5 — what kind of learning the student was doing when a heartbeat
// was credited.
//
// An ANALYTICS DIMENSION, not an authorisation input. Nothing branches on it:
// the number of seconds credited is identical whichever value arrives. See the
// note on StudyTimeEvent.activityId.
enum StudyActivityType {
  VIDEO
  THEORY
  QUIZ
  PRACTICE
  TRAP_HUNTER
  SRS_REVIEW
  VOCAB_PRACTICE
  LISTENING
}

// One row per credited heartbeat window. Append-only; the SINGLE source of
// truth for "how long has this student actually been studying".
//
// WHY A LEDGER RATHER THAN A COUNTER, and why no daily rollup yet.
//
// A running total with no event log behind it turns every crediting bug into
// permanent, unfixable data loss — the same reasoning that made XpTransaction a
// ledger in Sprint 10. Today's figure is SUM(creditedSeconds) over ~30 rows, so
// a rollup would buy nothing but a second source of truth to keep in step.
// UserDailyActivity.activeSeconds is the rollup to add IF this table is ever
// measured to be slow; note that its hot-path skip (GamificationService
// .recordActivityDay) returns before the update, so that is not a free change.
//
// SECONDS ARE NEVER CLIENT-AUTHORITATIVE. The client reports how long it
// believes it was active; the server decides what to store, clamped by
// creditableSeconds() against real time elapsed since the student's local
// midnight. No DTO carries a total, a percentage or an XP amount, and study
// time awards no XP at all — so there is no reward to farm by inflating it.
//
// occurredAt IS THE SERVER'S CLOCK, always. No request field sets it. Bucketing
// into a local day happens on READ (startOfDayInTimeZone), unlike
// UserDailyActivity.day which is bucketed at write time: an activity DAY is a
// historical fact that should not move, whereas study seconds are a quantity
// summed over a window and must re-bucket if the student's timezone is
// corrected.
model StudyTimeEvent {
  id     String @id @default(uuid())
  userId String

  activityType StudyActivityType

  // CLIENT-SUPPLIED AND DELIBERATELY NOT TRUSTED — the same standing as
  // WordReviewLog.sessionId ("analytics only, never trusted"). It is not
  // validated against lesson visibility, and that is a considered trade rather
  // than an oversight: the credited amount does not depend on it, study time
  // grants no XP and unlocks nothing, so a forged id can only dirty a
  // dimension. Checking it would add a lesson lookup to every heartbeat —
  // doubling the write cost of the feature to protect a column nothing reads.
  // WRITE-ONLY for now, exactly as LessonTaskAttempt was across Sprint 07-08.
  activityId String?

  // Idempotency is enforced by the database, never by an application check:
  // @@unique([userId, clientSessionId, sequence]) plus a conflict-free insert
  // (createManyAndReturn + skipDuplicates). A client retrying a timed-out
  // heartbeat is therefore free, and a replayed one credits nothing.
  clientSessionId String
  sequence        Int

  creditedSeconds Int
  occurredAt      DateTime
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientSessionId, sequence])
  // Serves both reads this table has: the per-heartbeat SUM for today's cap,
  // and the dashboard's SUM for the Daily Goal widget.
  @@index([userId, occurredAt])
  @@map("study_time_events")
}

// Sprint 11 — Listening content.
//
// THE POINT OF THIS MODULE IS THAT ONE RECORDING IS AUTHORED ONCE AND SERVES
// EVERY PRACTICE MODE. Before it, Listening was the only module with no backend
// at all: content was a client-side seed file (listeningContent.ts, ids were
// slugs) and progress lived in an in-memory Map that a refresh erased.
//
// Deliberately NOT built on Lesson. `deriveLessonStatus` (lesson-status.ts) is
// where Invariant A lives, and adding a listening stage there would make every
// Grammar course answer "does this lesson have a shadowing stage?" — exactly
// the coupling the three *IsGeneric tests exist to prevent. A Listening catalog
// also has no concept of a course, which is the shape the product wants.

/**
 * A practice mode a piece of listening content supports.
 * AN ENUM ARRAY (`ListeningContent.supportedModes`) RATHER THAN BOOLEAN
 * COLUMNS. `isDictationEnabled` + `isShadowingEnabled` costs one column per
 * mode and makes "no mode enabled" representable in two places; a mode
 * configuration table costs a join to answer a yes/no question. Adding
 * LISTENING_COMPREHENSION later is one enum value and no migration of shape.
 */
enum ListeningMode {
  DICTATION
  SHADOWING
}

enum ListeningMediaType {
  VIDEO
  AUDIO
}

/**
 * Where the media is hosted.
 * PROVIDER-NEUTRAL ON PURPOSE. The frontend commits to rendering YouTube (it
 * already owns youtubeUrlParser + the IFrame API loader for lesson videos);
 * the domain model does not. This mirrors the decision already recorded for
 * `Lesson.videoUrl`, whose DTO is a generic `@IsUrl` that happens to accept
 * YouTube URLs. `youtubeVideoId` as a column would have made an audio-only
 * recording unrepresentable.
 */
enum ListeningMediaProvider {
  YOUTUBE
  CLOUDINARY
  EXTERNAL_URL
}

/// A topic grouping for the Listening catalog — one section per category.
///
/// A REAL MODEL, NOT A STRING OR A FRONTEND ENUM. The seed file it replaces
/// declared its topics as a TypeScript union (`ListeningTopic`), which is the
/// same shape as the still-open "Grammar collection chips are derived from
/// course titles, not stored" debt: an admin could not add or rename one.
model ListeningCategory {
  id          String  @id @default(uuid())
  name        String
  nameVi      String
  orderIndex  Int
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personalized Roadmap (multi-pillar) — same fields, same semantics, same
  // precedent as Course.level/suitableGoals and VocabLibrary's own copy.
  level         CefrLevel?
  suitableGoals LearningGoal[] @default([])

  contents ListeningContent[]

  @@map("listening_categories")
}

/// One authored recording, plus the modes it can be practised in.
model ListeningContent {
  id           String    @id @default(uuid())
  categoryId   String
  title        String
  description  String?
  level        CefrLevel
  thumbnailUrl String?

  // Attribution. REQUIRED AT PUBLISH TIME when the provider is YOUTUBE — the
  // platform is embedded, never downloaded or re-hosted, and the channel it
  // came from has to remain visible to the student. Enforced in
  // segment-validation.ts rather than by a nullability constraint, because a
  // draft is allowed to be incomplete.
  sourceName String?
  sourceUrl  String?

  mediaType       ListeningMediaType
  mediaProvider   ListeningMediaProvider
  // Empty string is legal on a DRAFT and blocks publish. Seeded content starts
  // this way: the five migrated recordings have real transcripts but no legally
  // cleared media yet.
  mediaUrl        String
  // The provider's own id (a YouTube video id, a Cloudinary public id). Kept
  // beside mediaUrl rather than parsed on every read.
  externalMediaId String?
  durationMs      Int?

  supportedModes ListeningMode[]

  orderIndex  Int     @default(0)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Restrict: a category holding content cannot be deleted, only unpublished —
  // the same rule CourseService.remove enforces for courses holding lessons,
  // and enforced the same way (count first, FK as the backstop for the race).
  category ListeningCategory  @relation(fields: [categoryId], references: [id])
  segments ListeningSegment[]

  // Sprint 11 Phase 4A. Both are Restrict from the other side, which is what
  // finally arms the "students have already practised this" guard that
  // ListeningContentService.remove has carried since Phase 1 with nothing to
  // trigger it.
  dictationSegmentProgress ListeningDictationSegmentProgress[]
  dictationAttempts        ListeningDictationAttempt[]
  shadowingSegmentProgress ListeningShadowingSegmentProgress[]
  shadowingAttempts        ListeningShadowingAttempt[]

  @@index([categoryId, isPublished, orderIndex])
  @@index([isPublished, level])
  @@map("listening_contents")
}

/// One sentence of a recording. SHARED BY EVERY MODE — this is what makes
/// "one video, two modes" true rather than a claim. Dictation and Shadowing
/// read the same row; only their progress is separate.
model ListeningSegment {
  id         String @id @default(uuid())
  contentId  String
  orderIndex Int

  text           String
  /// Scoring input, computed at write time. NEVER SENT TO A STUDENT — the
  /// client must not be able to reconstruct the comparison the server will
  /// make, and it has no rendering use.
  normalizedText String
  ipa            String?
  translationVi  String?
  notes          String?

  // MILLISECONDS, as Int. The YouTube IFrame API speaks decimal seconds, but
  // Float makes boundary comparisons unreliable and Decimal is a heavy Prisma
  // type for plain arithmetic. Converted at the player boundary only. Same
  // reasoning that made LessonStepProgress.highestPositionSeconds an Int.
  startTimeMs Int
  endTimeMs   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // CASCADE, deliberately — and this is the one FK decision in this module
  // worth reading twice.
  //
  // A segment is CONTENT, so it has the same standing as a Question, which the
  // quiz's whole-document upsert deletes freely (QuizService.upsertTask). The
  // Restrict-because-a-student-worked-here rule lives one level up, on the
  // CONTAINER (LessonTask.lesson), and this module puts it in the matching
  // place: on ListeningContent, once Phase 4A adds progress.
  //
  // Restrict here would have made the admin editor unusable — removing a
  // sentence from a live recording would throw P2003 the moment any student had
  // practised it, and fixing a typo would be impossible.
  content ListeningContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  dictationProgress ListeningDictationSegmentProgress[]
  dictationAttempts ListeningDictationAttempt[]
  shadowingProgress ListeningShadowingSegmentProgress[]
  shadowingAttempts ListeningShadowingAttempt[]

  @@unique([contentId, orderIndex])
  @@index([contentId])
  @@map("listening_segments")
}

/// One student's standing on one sentence, for DICTATION only.
///
/// >>> NAMED FOR DICTATION, NOT FOR "A MODE" — DELIBERATELY <<<
/// The Sprint 11 architecture plan proposed a generic `ListeningSegmentProgress`
/// carrying a `mode` column so Shadowing could share the table. That was
/// rejected for Phase 4A on the owner's instruction, and the instruction is
/// right: Shadowing has no submit path yet, so its shape is a prediction. The
/// four fields below happen to look mode-neutral today, but `assisted` is
/// meaningless for Shadowing and a Shadowing row would want a confidence and a
/// transcript source that Dictation has no use for. A table generalised to fit
/// one real user and one imagined one fits the imagined one badly.
///
/// The cost is named rather than hidden: if 4B turns out to need exactly this
/// shape, it either adds a sibling table or renames this one in a migration.
/// That is a known, bounded cost paid later, against a guaranteed cost of
/// carrying a discriminator column no query filters on today.
///
/// NOTHING HERE IS A CACHE OF A COUNT. There is no `completedSegmentCount` and
/// no `bestAverageAccuracy` anywhere in this module: content-level completion
/// is derived per request from these rows against the live segment count, so
/// an admin adding or removing a sentence re-derives every student's standing
/// with no counter to recount. That is what makes segment editing safe on live
/// content, and it is the reason `ListeningSegment.content` can be Cascade.
model ListeningDictationSegmentProgress {
  id        String @id @default(uuid())
  userId    String
  segmentId String

  /// DUPLICATED FROM `segment.contentId`, and it is a FK — not a derived
  /// aggregate. A segment never changes content, so this value cannot drift.
  /// It exists because Prisma `groupBy` cannot group by a relation field:
  /// without it, "how many sentences has this student finished in each of
  /// these 20 recordings?" becomes one query per recording. It is assigned
  /// from `segment.contentId` on write and NEVER from a request body.
  contentId String

  /// Set once, on the first fully-correct submission, and never cleared —
  /// the same contract as `LessonStepProgress.completedAt`. Content-level
  /// completion is still derived, so adding a sentence correctly drops a
  /// recording back to in-progress without rewriting anyone's history.
  completedAt DateTime?

  /// Monotonic: `max(stored, new)`. A retry can never lower it, because
  /// punishing a student for practising again is the opposite of the point.
  bestAccuracyPercent Int?
  attemptCount        Int      @default(0)
  /// True once any attempt revealed a word. Sticky, like `completedAt`: a
  /// sentence solved with help was not solved unaided, and a later clean run
  /// does not rewrite that. Excluded from `wordsCorrect` at scoring time too.
  assisted            Boolean  @default(false)
  lastAttemptAt       DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CASCADE with the segment: an admin must stay able to fix or remove a
  /// sentence on live content, exactly as they can delete a Question.
  segment ListeningSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  /// RESTRICT on the content: this is the row that protects a recording
  /// students have practised from being deleted. `ListeningContentService.remove`
  /// has carried the matching guard and the P2003 backstop since Phase 1 —
  /// this relation is the first thing that can actually make it fire.
  content ListeningContent @relation(fields: [contentId], references: [id])

  @@unique([userId, segmentId])
  @@index([userId, contentId, completedAt])
  @@map("listening_dictation_segment_progress")
}

/// One submitted dictation attempt. APPEND-ONLY.
///
/// WHY A TABLE AND NOT A COLUMN ON THE PROGRESS ROW. Idempotency was required
/// at the database level, and a unique constraint needs a row per attempt —
/// `LessonTaskProgress.lastClientAttemptId` is a compare-and-replay against
/// the most recent attempt only, which is weaker and cannot survive a client
/// replaying an id from two attempts ago.
///
/// KNOWN DEBT, STATED UP FRONT: this table is WRITE-ONLY in Phase 4A. Nothing
/// reads it, exactly as `LessonTaskAttempt` was write-only across Sprints
/// 07–08. It is accepted here because the unique constraint is the feature —
/// but the first reader (an attempt-history surface) should not be deferred
/// indefinitely, and until then an e2e assertion on the row set after a retry
/// is what keeps it from rotting.
model ListeningDictationAttempt {
  id        String @id @default(uuid())
  userId    String
  segmentId String
  contentId String

  /// What the student typed, verbatim. Stored because it is the only thing
  /// that can explain a score to a student who disputes it.
  typedText         String
  revealedWordCount Int

  /// The reference sentence AS IT WAS WHEN GRADED. Admins may fix a typo on a
  /// live recording; without this snapshot an old attempt's score would be
  /// unexplainable against the edited text. One text column on an append-only
  /// table buys that, with no content versioning.
  referenceTextSnapshot String

  /// SERVER-COMPUTED, every one of them. No DTO carries these fields, so a
  /// client-supplied score is a shape that does not exist.
  accuracyPercent Int
  wordsCorrect    Int
  wordsTotal      Int
  solved          Boolean

  submittedAt DateTime @default(now())

  /// The idempotency key, scoped per user by the unique below rather than
  /// globally — one student's key space can never collide with another's.
  /// Same contract as `LessonTaskAttempt.clientAttemptId` and
  /// `WordReviewLog.clientReviewId`.
  clientAttemptId String

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment ListeningSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  content ListeningContent @relation(fields: [contentId], references: [id])

  @@unique([userId, clientAttemptId])
  @@index([userId, segmentId, submittedAt])
  @@map("listening_dictation_attempts")
}

/// Where a transcript came from.
///
/// One value today, and the enum exists anyway: the whole point of
/// `SpeechToTextProvider` is that the engine is replaceable, and an attempt
/// whose score is disputed months from now is unexplainable if nobody can tell
/// which engine produced its transcript. `BROWSER_SPEECH_API` is deliberately
/// ABSENT — the browser recogniser was removed in Phase 3.1 and no row may
/// ever claim to have come from it.
enum TranscriptSource {
  GEMINI
}

/// One student's standing on one sentence, for SHADOWING only.
///
/// SEPARATE FROM DICTATION, and not a generic table with a `mode` column. The
/// two modes looked similar enough to merge right up until they were both
/// built: Dictation carries `assisted` (words revealed) which is meaningless
/// for speech, Shadowing carries a pass threshold which Dictation does not have
/// (it demands 100%), and their attempt rows share not one column beyond the
/// idempotency key. A `mode` column would have bought a shared index and cost
/// every query a filter it can never forget.
model ListeningShadowingSegmentProgress {
  id        String @id @default(uuid())
  userId    String
  segmentId String

  /// Duplicated FK, exactly as on the dictation row and for the same reason:
  /// Prisma `groupBy` cannot group by a relation field, so without it the
  /// batch catalog read is one query per recording. Assigned from
  /// `segment.contentId` on write, never from a request.
  contentId String

  /// Set once, on the first attempt that reaches the pass threshold, and never
  /// cleared. Content-level completion is still DERIVED against the live
  /// segment list — there is no cached count in this module.
  completedAt DateTime?

  /// Monotonic: `max(stored, new)`. A retry can never lower it.
  bestAccuracyPercent Int?
  attemptCount        Int      @default(0)
  lastAttemptAt       DateTime @default(now())

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment ListeningSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  /// RESTRICT on the content, matching dictation: this row is what protects a
  /// recording students have practised from being deleted.
  content ListeningContent @relation(fields: [contentId], references: [id])

  @@unique([userId, segmentId])
  @@index([userId, contentId, completedAt])
  @@map("listening_shadowing_segment_progress")
}

/// One submitted shadowing attempt. APPEND-ONLY.
///
/// >>> NO AUDIO IS STORED HERE, OR ANYWHERE. <<<
/// The uploaded blob exists as a Buffer for the lifetime of one request and is
/// never written to disk, Cloudinary, S3 or this table. There is deliberately
/// no `audioUrl` column: a column is an invitation, and the product decision
/// was that a student's voice is processed and discarded. What survives is the
/// TRANSCRIPT — text the student can read, dispute and understand, which is
/// the minimum needed to explain a score and the maximum that should be kept.
model ListeningShadowingAttempt {
  id        String @id @default(uuid())
  userId    String
  segmentId String
  contentId String

  /// Exactly what the engine returned, before any normalization. Kept because
  /// it is the only thing that can explain a score to a student who disputes
  /// it — and because it is the evidence that distinguishes "the student
  /// misread the sentence" from "the engine misheard them".
  rawTranscript        String
  /// The form the alignment actually ran on. Stored alongside the raw text
  /// because the normalizer's rules can widen later, and an old score has to
  /// stay reproducible against the rules that produced it.
  normalizedTranscript String
  transcriptSource     TranscriptSource

  /// The reference sentence AS IT WAS WHEN GRADED. Admins may fix a typo on a
  /// live recording; without this an old attempt's score is unexplainable.
  referenceTextSnapshot String

  /// SERVER-COMPUTED, all of them. No DTO carries any of these fields, so a
  /// client-supplied score is a shape that does not exist.
  accuracyPercent      Int
  wordsCorrect         Int
  wordsTotal           Int
  /// The three ways a transcript can differ from the reference. Stored rather
  /// than derived because the alignment is not reproducible from the two texts
  /// alone once the normalizer changes.
  substitutions        Int
  insertions           Int
  deletions            Int
  passed               Boolean
  /// The threshold this attempt was judged against. An env-configurable pass
  /// mark that is not recorded per attempt makes every historical score
  /// meaningless the day it is tuned.
  passThresholdPercent Int

  /// Advisory, from the client. NOT trusted and NOT used for any limit — the
  /// enforced cap is the upload byte size, which the client cannot misreport.
  durationMs Int?

  submittedAt DateTime @default(now())

  /// Sprint 11 Phase 4C — optional AI pronunciation coaching for this attempt.
  ///
  /// NULL MEANS "NOT ASKED FOR", not "nothing to say": feedback is requested by
  /// an explicit second action and most attempts never have one. Stored so a
  /// second press returns the SAME advice instead of buying a second opinion —
  /// this call costs money and is not deterministic, exactly like transcription,
  /// and coaching that changes its mind on a re-read is worse than none.
  ///
  /// It is PROSE AND ONLY PROSE. There is no aiScore column and there must
  /// never be one: this attempt already has one number, computed from the
  /// alignment, and a second number from a model that heard one clip would be a
  /// fabricated measurement sitting next to a real one.
  aiFeedback      String?
  aiFeedbackAt    DateTime?
  /// Which engine wrote it, so old advice stays attributable after a model swap.
  aiFeedbackModel String?

  /// The idempotency key, scoped per user. Checked BEFORE the speech engine is
  /// called, so a replay costs nothing and returns the original verdict rather
  /// than paying for a second transcription that could disagree with the first.
  clientAttemptId String

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  segment ListeningSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  content ListeningContent @relation(fields: [contentId], references: [id])

  @@unique([userId, clientAttemptId])
  @@index([userId, segmentId, submittedAt])
  @@map("listening_shadowing_attempts")
}

// ============================================================================
// Personalized Onboarding & Placement Test
// ============================================================================
//
// Dedicated question bank — deliberately NOT sampled from real Lesson/Question
// rows (product decision), but shaped identically to Question so
// grade-question.ts's gradeQuestion()/validateQuestionContent() work
// unmodified: they only ever need {type, options, correctAnswer}.
model PlacementQuestion {
  id            String             @id @default(uuid())
  // Which pillar this question screens. Reuses CourseType rather than a new
  // enum — Grammar/Vocabulary/Listening is a closed set matching the
  // product's three pillars, and the Placement Test never needs a fourth.
  section       CourseType
  type          QuestionType
  // Required here (unlike the optional Question.difficulty, which is
  // authored-but-inert everywhere it's used today) — selection genuinely
  // depends on it: POST /placement/start samples a fixed 2 EASY / 1 MEDIUM /
  // 1 HARD per section.
  difficulty    QuestionDifficulty
  content       String
  options       Json?
  correctAnswer Json
  explanation   String?
  // Listening-section items only. `content` holds ONLY the final question
  // (or true/false statement, or fill-blank prompt) shown on screen;
  // `transcript` holds the spoken dialogue and is never rendered as text —
  // it is read aloud client-side (Web Speech API today; a real recorded
  // audioUrl, once available, takes precedence over transcript playback).
  audioUrl      String?
  transcript    String?
  imageUrl      String?
  isPublished   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([section, difficulty, isPublished])
  @@map("placement_questions")
}

// One row per attempt. Mutable while in-progress (its child PlacementAnswer
// rows accumulate as the student answers), effectively append-only once
// completedAt is set. Deliberately ONE table, not the LessonTaskProgress +
// LessonTaskAttempt pair the quiz engine uses — that split exists because one
// LessonTask is retaken many times under a single (userId, taskId) row and
// needs a separate cache of "the latest completed attempt" apart from
// per-attempt history. A PlacementAttempt has no such ambiguity: every
// attempt already gets its own server-minted id, so "the current attempt" and
// "a specific historical attempt" are never in tension — see
// placement.service.ts's design note on why clientAttemptId does not exist
// anywhere in this feature.
model PlacementAttempt {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot of User.learningGoal at the moment this attempt started — so a
  // goal change mid-attempt (PUT /placement/goal, always allowed) cannot
  // retroactively change what this attempt is scored/explained against.
  goal LearningGoal?

  // The resolved, ordered set of 12 question ids, frozen here at creation.
  // Never reshuffled on refresh — this row, once created, IS the test; a
  // resumed session always sees the exact same questions in the exact same
  // order.
  questionIds Json

  startedAt   DateTime  @default(now())
  // Hard 5-minute server-authoritative deadline, computed ONCE at creation
  // and never recomputed. Because POST /placement/start is idempotent purely
  // on "does an incomplete attempt already exist for this user" (no
  // client-supplied token involved), a refresh or a repeated start call can
  // never push this forward — that is what makes "refresh never resets the
  // timer" true by construction rather than a special case. Enforcement is
  // lazy (see PlacementService.finalizeIfDue): the backend does not depend on
  // any client call arriving at or after this moment to consider the attempt
  // over — the next request of ANY kind that touches this row finalizes it.
  expiresAt   DateTime
  completedAt DateTime?

  // Section scores are 0-100, always a multiple of 25 (4 questions/section).
  // Unanswered questions count as incorrect — finalize iterates questionIds
  // and treats a missing PlacementAnswer row as a wrong answer, no special
  // casing beyond "absence = 0".
  grammarScore    Int?
  vocabularyScore Int?
  listeningScore  Int?
  overallScore    Int?
  estimatedLevel  CefrLevel?
  durationSeconds Int?

  answers PlacementAnswer[]

  @@index([userId, completedAt])
  @@map("placement_attempts")
}

// One row per (attempt, question) — deliberately NOT a single JSON blob of
// all answers on PlacementAttempt. A shared JSON blob updated by
// read-modify-write under Postgres READ COMMITTED has a real lost-update
// race: two concurrent answers to DIFFERENT questions can both read the same
// old blob and the second write silently discards the first question's
// answer, with or without a surrounding transaction (only the eventual
// UPDATE statement takes a row lock — by then both transactions already read
// the stale value). A child table with @@unique([attemptId, questionId]),
// written via upsert, makes this impossible by construction: concurrent
// answers to different questions touch different rows and never contend: a
// concurrent double-submit of the SAME question resolves as ordinary
// last-write-wins on that one row, which is the correct, harmless outcome.
model PlacementAnswer {
  id         String           @id @default(uuid())
  attemptId  String
  attempt    PlacementAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  // The SubmittedAnswer-shaped value — one of the four QuestionType
  // submission shapes from grade-question.ts (optionId / value / text /
  // orderedOptionIds).
  submitted  Json
  answeredAt DateTime         @default(now())

  @@unique([attemptId, questionId])
  @@map("placement_answers")
}

// The deterministic roadmap plus an optional, advisory, cached AI narrative.
// Persisted (not derived on every read) for two reasons: it is the
// existence-signal a completed onboarding leaves behind for the wizard's own
// fine-grained resume logic (GET /placement/status), and the AI summary is
// expensive/non-deterministic and must be cached exactly like Shadowing's
// aiFeedback — regenerating it on every dashboard visit would be both slow
// and liable to contradict itself between visits.
model Roadmap {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  goal               LearningGoal
  // Null on the beginner-skip path (no test was ever taken).
  placementAttemptId String?
  estimatedLevel     CefrLevel?
  // Null only for rows written before this field existed. See the
  // LevelSource enum comment for why this can't be derived from
  // estimatedLevel's nullability alone.
  levelSource        LevelSource?

  // Ordered [{ phase, courseType, courseId, reason }] — deliberately NO
  // title/thumbnail here. Those are joined fresh from Course on every read
  // (GET /placement/roadmap): denormalizing display data into this snapshot
  // would create a second source of truth that silently goes stale the
  // moment an admin renames or unpublishes a recommended course.
  items Json

  // Advisory only — see roadmap/roadmap-analysis.provider.ts. Structurally
  // incapable of altering `items`: the provider interface returns prose,
  // never course ids. Checked-before-called caching, same shape as
  // ListeningShadowingAttempt.aiFeedback: NULL means "not asked for", not
  // "nothing to say".
  aiSummary      String?
  aiSummaryAt    DateTime?
  aiSummaryModel String?

  // POST /placement/roadmap/plan — set only when an AI planner actually
  // selected/ordered `items` (as opposed to the deterministic fallback).
  // Cleared on retake alongside aiSummary* — a stale AI plan describes a
  // profile that no longer exists. Structurally separate from aiSummary*:
  // narration can exist without planning ever having run, and vice versa.
  aiPlanningModel  String?
  aiPlanningUsedAt DateTime?

  // Bumped only when `items`/`estimatedLevel` change (finalizeNow,
  // persistRoadmapAndMaybeOnboard) — NOT by requestRoadmapAnalysis's or
  // requestRoadmapPlan's own narrower .update() calls. This is deliberate:
  // it is the snapshot POST /placement/roadmap/plan reads before calling
  // Gemini and conditions its final write on, so that a retake racing an
  // in-flight AI call can never have its fresh roadmap overwritten by a
  // stale one. Do NOT use `updatedAt` for this — it changes on ANY field
  // write (including an unrelated concurrent /analysis call) and would
  // cause false-positive staleness detection.
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roadmaps")
}
