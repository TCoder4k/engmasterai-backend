# Template for `.env.test` — the environment used by `npm run test` and
# `npm run test:e2e`. Copy this file to `.env.test` and fill in the values:
#
#   cp .env.test.example .env.test
#
# `.env.test` itself is git-ignored (see .gitignore) and must never be
# committed: it holds a real database URL and a JWT secret, and neither
# belongs in version control even when they only point at local test
# infrastructure. Only THIS template is committed.
#
# The suites refuse to run unless NODE_ENV=test and DATABASE_URL points at a
# database whose name ends in `_test` — see test/test-database.util.ts. That
# guard exists because test fixtures once leaked into the development database
# and became visible to students (see docs/memory.md).

NODE_ENV=test

# MUST be a dedicated test database, MUST end in `_test`, and MUST NOT be the
# development database (`engmasterai`). Create it once with:
#   docker exec engmasterai-postgres psql -U <user> -d postgres \
#     -c "CREATE DATABASE engmasterai_test;"
# Migrations are applied automatically by test/jest-global-setup.ts.
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/engmasterai_test?schema=public"

# Any throwaway value of at least 16 characters. Never reuse the development
# or production secret here.
JWT_SECRET=<any-throwaway-value-min-16-chars>

CORS_ALLOWED_ORIGINS=http://localhost:5174

# Redis is shared with development, but each Redis-backed suite pins its own
# dedicated logical DB (14 and 15) and flushes only that one — never DB 0.
#
# Do NOT set REDIS_HOST / REDIS_PORT here. ConfigService.get() resolves the
# Joi-validated env BEFORE process.env, so defining them freezes them at boot
# and auth.e2e-spec.ts's Redis-outage suite (which simulates an outage by
# mutating process.env.REDIS_HOST at runtime) would silently keep connecting
# to the real Redis and fail. Left unset, redis.module.ts's own
# 'localhost'/6379 defaults apply — which is where env.validation.ts already
# documents those defaults as being owned.

# Rate limits are deliberately raised far above production values: the e2e
# suites register and log in many users per run and would otherwise trip the
# real limits (register defaults to 3/hour). The limiter itself is exercised
# by its own spec with explicit values, not by these.
AUTH_LOGIN_RATE_LIMIT_MAX=100000
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_IP_RATE_LIMIT_MAX=100000
AUTH_REGISTER_RATE_LIMIT_MAX=100000
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_REGISTER_EMAIL_RATE_LIMIT_MAX=100000
AUTH_REFRESH_RATE_LIMIT_MAX=100000
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REFRESH_IP_RATE_LIMIT_MAX=100000

# Both features stay OFF in tests, so no real Google client ID, Resend API key
# or Cloudinary credential is ever needed here. Email falls through to
# NullMailProvider (src/mail/mail.module.ts) and nothing is actually sent.
GOOGLE_AUTH_ENABLED=false
EMAIL_ENABLED=false

# Off in tests too, same reasoning — no real Cloudflare secret key needed.
TURNSTILE_ENABLED=false
