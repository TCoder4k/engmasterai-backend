{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "auth/lua/*.lua",
      "chat/lua/*.lua",
      "speaking/lua/*.lua",
      "speaking/live/lua/*.lua",
      "community-chat/live/lua/*.lua"
    ],
    "watchAssets": true
  }
}
