# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated exact origins (scheme://host[:port], no path/query/
# fragment, never a wildcard — credentials are always enabled). Required in
# production; defaults to http://localhost:5174 in development/test if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5174

# Only set this if the app runs behind a real reverse proxy/load balancer.
# "false" (default) = trust nothing, use the raw socket IP. Otherwise a
# positive hop count (e.g. "1") or a specific trusted proxy IP/CIDR — never
# "true" (trusts every hop unconditionally). Governs Express's req.ip, which
# every rate-limit/IP-based check below reads — never a hand-parsed
# X-Forwarded-For header.
TRUST_PROXY=false

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRATION=1d

# Redis (session/refresh-token store — see docker-compose.yml)
REDIS_HOST=localhost
REDIS_PORT=6379
# Alternative to REDIS_HOST/REDIS_PORT: a single connection string, takes
# precedence over the two above if set.
# REDIS_URL=redis://localhost:6379

# Refresh tokens
REFRESH_TOKEN_TTL_SECONDS=2592000

# Auth rate limiting (Sprint 01C) — fixed-window counters, atomic via Redis
# (see src/auth/lua/rate-limit-incr.lua). Every endpoint below evaluates
# multiple buckets together (see docs/memory.md's Sprint 01C entry for the
# full key design and rationale); a request is rejected (429) if any bucket
# is exceeded.
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOGIN_IP_RATE_LIMIT_MAX=20

AUTH_REGISTER_RATE_LIMIT_MAX=3
AUTH_REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
AUTH_REGISTER_EMAIL_RATE_LIMIT_MAX=5

AUTH_REFRESH_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_REFRESH_IP_RATE_LIMIT_MAX=30

# Google Sign-In (Sprint 02A) — off by default; the whole app boots normally
# with zero Google config. Set GOOGLE_AUTH_ENABLED=true AND GOOGLE_CLIENT_ID
# to enable POST /auth/google and /auth/google/link — enabling without a
# client ID fails startup. GOOGLE_CLIENT_ID is not a secret (it's the OAuth
# client's public identifier, also used as VITE_GOOGLE_CLIENT_ID in the
# frontend) — never put a Google *client secret* here or anywhere else in
# this app; none is required for the ID-token verification flow this app uses.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Pre-verification IP-only limiting on both Google endpoints (an unverified
# JWT claim is attacker-chosen, never used as a rate-limit key — see
# docs/adr/004-google-auth.md). AUTH_GOOGLE_LINK_RATE_LIMIT_MAX guards a
# second, identity-keyed bucket checked inside AuthService.linkGoogle()
# itself, after the credential is verified — /auth/google/link is
# functionally a password-verification oracle and is rate-limited at least
# as strictly as login.
AUTH_GOOGLE_IP_RATE_LIMIT_MAX=30
AUTH_GOOGLE_RATE_LIMIT_WINDOW_SECONDS=60

AUTH_GOOGLE_LINK_IP_RATE_LIMIT_MAX=20
AUTH_GOOGLE_LINK_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_GOOGLE_LINK_RATE_LIMIT_MAX=5

# Transactional email + email verification (Sprint 02B) — off by default;
# the whole app boots with zero mail configuration and both new
# /auth/email-verification/* endpoints fail closed rather than attempting a
# real provider request. Set EMAIL_ENABLED=true AND every var below to
# enable — enabling without them fails startup. EMAIL_PROVIDER_API_KEY is
# backend-only and must never be exposed to the frontend. FRONTEND_APP_URL
# is the canonical single application URL used to build links embedded in
# outgoing emails — distinct from CORS_ALLOWED_ORIGINS.
# EMAIL_PROVIDER must be 'brevo' — the only value with a real adapter
# (BrevoMailProvider); Resend/SendGrid were both tried and their adapters
# removed the same day, 2026-08-20 (see docs/memory.md). EMAIL_FROM must be
# a sender Brevo has verified (Single Sender Verification or domain
# authentication — otherwise every send is rejected regardless of recipient).
# EMAIL_PROVIDER_API_KEY must be Brevo's v3 API key (dashboard prefix
# `xkeysib-`), NOT the separate SMTP key (prefix `xsmtpsib-`, for SMTP relay
# login only) — the two are not interchangeable.
EMAIL_ENABLED=false
EMAIL_PROVIDER=brevo
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=EngMasterAI
EMAIL_PROVIDER_API_KEY=your-brevo-v3-api-key
EMAIL_PROVIDER_TIMEOUT_MS=5000
FRONTEND_APP_URL=http://localhost:5174
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30

# Resend: guard-level IP bucket + a service-level user-scoped bucket
# (checked inside AuthService.resendVerification()). Verify: guard-level IP
# bucket + a token-hash-prefix bucket (bounds repeated attempts against one
# specific link; brute-forcing the 256-bit token itself remains infeasible
# regardless).
AUTH_EMAIL_VERIFY_RESEND_USER_RATE_LIMIT_MAX=3
AUTH_EMAIL_VERIFY_RESEND_IP_RATE_LIMIT_MAX=10
AUTH_EMAIL_VERIFY_RESEND_RATE_LIMIT_WINDOW_SECONDS=900

AUTH_EMAIL_VERIFY_IP_RATE_LIMIT_MAX=30
AUTH_EMAIL_VERIFY_TOKEN_RATE_LIMIT_MAX=10
AUTH_EMAIL_VERIFY_RATE_LIMIT_WINDOW_SECONDS=900

# Forgot password / password reset (Sprint 02C) — reuses EMAIL_ENABLED above
# directly; no separate feature flag. PASSWORD_RESET_GOOGLE_NOTICE_ENABLED
# (default true) sends a distinct instructional email to Google-only accounts
# instead of doing nothing on /auth/password/forgot; set to false for
# deployments prioritizing minimal outbound email (see ADR 006).
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
PASSWORD_RESET_GOOGLE_NOTICE_ENABLED=true

# Forgot: guard-level IP bucket + a normalized-email-hash combo bucket.
# Reset: guard-level IP bucket only (256-bit token space already makes brute
# force infeasible; the endpoint sets newPassword, never verifies a guess).
AUTH_PASSWORD_FORGOT_IP_RATE_LIMIT_MAX=10
AUTH_PASSWORD_FORGOT_EMAIL_RATE_LIMIT_MAX=3
AUTH_PASSWORD_FORGOT_RATE_LIMIT_WINDOW_SECONDS=3600

AUTH_PASSWORD_RESET_IP_RATE_LIMIT_MAX=20
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=300

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Sprint 11 Phase 4B — Shadowing speech-to-text ───────────────────────────
# Audio is uploaded, transcribed and DISCARDED within one request. Nothing is
# stored: no disk, no Cloudinary, no S3, no database column. Only the resulting
# transcript is kept, because a score nobody can trace is a score nobody can
# dispute.
#
# Optional. Without a key the app boots normally and Shadowing reports itself
# unavailable at the point of use — one optional feature's configuration is not
# a hard dependency of the login page.
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-2.5-flash
SHADOWING_STT_TIMEOUT_MS=20000
# PROVISIONAL until real learner speech has been measured against the engine.
SHADOWING_PASSING_ACCURACY_PERCENT=70

# ── Sprint 11 Phase 4C — AI pronunciation feedback ──────────────────────────
# A SECOND paid call on the same recording, made only when the student asks for
# it. The audio is uploaded again and discarded again; the prose that comes back
# is stored on the attempt so a second press costs nothing.
#
# This one IS told the target sentence — safe only because nothing it returns is
# graded. See src/listening/shadowing/pronunciation-feedback.provider.ts.
#
# Shares GEMINI_API_KEY above. Without a key, the button reports itself
# unavailable and the attempt's score is unaffected.
GEMINI_FEEDBACK_MODEL=gemini-2.5-flash
SHADOWING_FEEDBACK_TIMEOUT_MS=25000

# ── Personalized Onboarding — AI roadmap narration (Phase 6) ───────────────
# A one-time orientation paragraph on top of the deterministic roadmap
# (goal + level + section scores + the finished phase list -> prose). Text
# only, no audio. Cached on Roadmap.aiSummary after the first successful
# call, so a second request never pays for another generation.
#
# Shares GEMINI_API_KEY above. Without a key, the endpoint reports itself
# unavailable and the deterministic roadmap (which is never AI-generated) is
# unaffected — see src/placement/roadmap/roadmap-analysis.provider.ts.
GEMINI_ROADMAP_MODEL=gemini-2.5-flash
PLACEMENT_ANALYSIS_TIMEOUT_MS=20000

# ── Floating Dictionary — Phase A (Sprint 12) ───────────────────────────────
# Deterministic 3-tier lookup: VocabWord -> Redis cache -> freedictionaryapi.com
# + one Gemini call for the Vietnamese translation line only (never the English
# definition itself — that always comes from a real source, or the lookup is an
# honest 404). Autocomplete (GET /dictionary/suggestions) never calls Gemini or
# the external source — VocabWord only.
#
# Shares GEMINI_API_KEY above. Without a key, VI translation degrades to
# viTranslationSource:'NONE' rather than failing the whole lookup.
GEMINI_DICTIONARY_TRANSLATION_MODEL=gemini-3.5-flash-lite
DICTIONARY_TRANSLATION_TIMEOUT_MS=10000
DICTIONARY_SOURCE_TIMEOUT_MS=8000
# 30 days default — a dictionary entry is close to immutable.
DICTIONARY_CACHE_TTL_SECONDS=2592000

# ── Engy Chat — Phase B (Sprint 12) ─────────────────────────────────────────
# Multi-turn conversational assistant, Redis-only bounded history (no Prisma
# model). Scoped to EngMasterAI (grammar/vocab explanations, examples, study
# guidance) — see src/chat/gemini-engy-chat.provider.ts's system instruction.
#
# Shares GEMINI_API_KEY above. Without a key, POST /chat/messages reports
# itself unavailable (503) — Placement Test lock/rate limiting still apply.
GEMINI_ENGY_MODEL=gemini-3.5-flash-lite
CHAT_REPLY_TIMEOUT_MS=20000
# Sliding TTL for a user's bounded chat:session:<userId> history AND how long
# a committed idempotency claim's reply stays replayable without a second
# Gemini call. 30 minutes default.
CHAT_SESSION_TTL_SECONDS=1800

# ── Speaking Partner ─────────────────────────────────────────────────────
# Tap-to-talk voice conversation over Gemini LIVE (audio-to-audio,
# WebSocket /speaking/live) — see src/speaking/live/. Replaces the old
# two-step STT-then-text-reply pipeline entirely; there is no more
# POST .../turns. Redis-only bounded per-attempt transcript history (no
# Prisma model for turn text — see SpeakingAttempt's own schema comment for
# why only the aggregate turnCount is persisted).
#
# Shares GEMINI_API_KEY above. Without a key, opening a Speaking Live
# connection closes immediately (see GeminiSpeakingLiveConnectionProvider).
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# One of Gemini's standard TTS voice names. To confirm a custom/cloned
# voice option exists, or just see the full catalog:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
GEMINI_LIVE_VOICE=Erinome
# BCP-47 hints for Gemini's own transcription of each side of the call,
# comma-separated. Empty ("") omits the field entirely (Gemini's automatic
# language detection) — only meant for the A/B/C comparison in the Speaking
# Live sprint doc, not a supported permanent value.
GEMINI_LIVE_INPUT_LANGUAGE_CODES=en-US,vi-VN
GEMINI_LIVE_OUTPUT_LANGUAGE_CODES=en-US,vi-VN
# Temporary diagnostic scaffolding, OFF by default. When true, dumps each
# real Speaking Live turn's captured audio to a WAV file under the OS temp
# dir (never the repo) plus duration/RMS/peak stats to the console, for
# local debugging only — never enable in a shared/deployed environment.
SPEAKING_LIVE_AUDIO_DEBUG_DUMP=false
# Sliding TTL for a bounded speaking:session:<userId>:<attemptId> transcript
# history, refreshed on every finalized turn. 30 minutes default.
SPEAKING_SESSION_TTL_SECONDS=1800
# A separate, on-demand Speaking Gemini job — subtitle translation
# (POST /speaking/translate), own model/timeout var, never folded into the
# Live conversation itself.
GEMINI_SPEAKING_TRANSLATE_MODEL=gemini-3.5-flash-lite
SPEAKING_TRANSLATE_TIMEOUT_MS=20000
