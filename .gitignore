# temp directory
.temp
.tmp

# Throwaway one-off scripts and everything tsc emits for them. The existing
# .tmp entry above only matches a file or directory literally named ".tmp",
# so a dbcheck.tmp.js/.d.ts/.js.map trio was committed by accident in 2cdcb5f.
# The trailing .* is what catches the .js.map, which *.tmp.js does not.
*.tmp.*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

/generated/prisma
